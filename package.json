{
  "name": "portaless",
  "version": "0.0.10",
  "description": "Portaless: CMS ligero open source basado en Astro, sin hosting pagado, con modulo de comercio opcional, Trust Layer para agentes de IA, dashboard modular con skins, Atomic Elements",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "astro dev",
    "start": "tsx scripts/start-docker.mjs",
    "start:self-host": "tsx scripts/start-docker.mjs",
    "self-host:dev": "PORTALESS_SQLITE_PATH=./portaless.db tsx scripts/start-docker.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "setup": "tsx scripts/setup.mjs",
    "setup:d1": "tsx scripts/setup-d1.mjs",
    "migrate": "tsx scripts/migrate.mjs",
    "test:email": "node --import tsx scripts/test-auth-email.mjs",
    "doctor": "tsx scripts/doctor.mjs",
    "migrate:d1": "tsx scripts/migrate-d1.mjs",
    "staging:create": "node node_modules/tsx/dist/cli.mjs scripts/staging/create.mjs",
    "staging:destroy": "node scripts/staging/destroy.mjs",
    "staging:docker:create": "node --import tsx scripts/staging/docker.mjs create",
    "staging:docker:destroy": "node --import tsx scripts/staging/docker.mjs destroy",
    "mcp": "tsx packages/mcp-server/src/index.ts",
    "mcp:http": "PORTALESS_MCP_TRANSPORT=http tsx packages/mcp-server/src/index.ts",
    "test:browser": "playwright test",
    "generate-schema": "node scripts/generate-schema.mjs",
    "publish": "tsx scripts/publish-site.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@noble/post-quantum": "^0.5.0",
    "astro": "^7.3.3",
    "better-sqlite3": "^12.0.0",
    "canonicalize": "^2.0.0",
    "tsx": "^4.23.13",
    "web-bot-auth": "^0.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@vitest/coverage-v8": "^5.0.5",
    "typescript": "~5.6.3",
    "vitest": "^5.0.5"
  }
}
