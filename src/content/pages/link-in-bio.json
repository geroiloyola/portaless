{
  "version": "0.1",
  "slug": "link-in-bio",
  "title": "Ana Ruiz — Creadora digital",
  "description": "Pagina de ejemplo de link-in-bio construida con Atomic Elements: perfil, enlaces, redes y tienda de afiliados",
  "root": [
    {
      "id": "perfil",
      "type": "ProfileHeader",
      "props": {
        "avatarUrl": "https://placehold.co/160x160/261C15/C5D86D?text=AR&font=source-sans-pro",
        "name": "Ana Ruiz",
        "bio": "Creadora digital. Diseño, no-code y herramientas para independent makers.",
        "bgColor": "#261C15"
      }
    },
    {
      "id": "heading-enlaces",
      "type": "Heading",
      "props": { "text": "Mis enlaces", "level": "h2", "align": "center" }
    },
    {
      "id": "enlaces",
      "type": "LinkList",
      "props": {
        "title": "Encuentrame en",
        "buttonStyle": "solid",
        "links": [
          { "label": "Mi blog", "url": "/blog/", "icon": "blog", "enabled": true },
          { "label": "Portafolio de proyectos", "url": "/pages/portafolio/", "icon": "store", "enabled": true }
        ]
      }
    },
    {
      "id": "redes",
      "type": "SocialIcons",
      "props": {
        "align": "center",
        "links": [
          { "platform": "instagram", "url": "https://instagram.com/jerrybantz" },
          { "platform": "youtube", "url": "https://www.youtube.com/@jerrybantz" }
        ]
      }
    },
    {
      "id": "tienda",
      "type": "StoreBlock",
      "props": { "columns": 2, "limit": 4 }
    }
  ]
}
