{
  "version": "0.1",
  "slug": "ejemplo-atomic-elements",
  "locale": "en",
  "title": "Page built with Atomic Elements",
  "description": "Example page generated by the Portaless visual editor",
  "root": [
    {
      "id": "hero1",
      "type": "Hero",
      "props": {
        "title": "Welcome to Portaless",
        "subtitle": "This page was built by dragging elements, without writing code",
        "bgColor": "#111827"
      }
    },
    {
      "id": "heading1",
      "type": "Heading",
      "props": { "text": "Why Atomic Elements is different", "level": "h2", "align": "left" }
    },
    {
      "id": "columns1",
      "type": "Columns",
      "props": { "count": 2, "gap": 20 },
      "children": [
        {
          "id": "p1",
          "type": "Paragraph",
          "props": { "text": "Every element translates to a single HTML node, without the DOM depth that slows other visual editors down." }
        },
        {
          "id": "p2",
          "type": "Paragraph",
          "props": { "text": "The same JSON you see here is exactly what the visual editor produces — there is no intermediate translation step." }
        }
      ]
    },
    {
      "id": "btn1",
      "type": "Button",
      "props": { "label": "Open the editor", "href": "/editor/", "variant": "solid" }
    },
    {
      "id": "spacer1",
      "type": "Spacer",
      "props": { "height": 24 }
    },
    {
      "id": "mapa1",
      "type": "Map",
      "props": {
        "lat": -33.4372,
        "lon": -70.6506,
        "label": "Portaless Studio & Showroom",
        "address": "Santiago, Chile",
        "zoom": 15
      }
    }
  ]
}
