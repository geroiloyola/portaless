---
// v0.0.8: FIX -- title/description ya no son obligatorios ni tienen
// default fijo. Antes este layout siempre renderizaba su propio
// <title>/<meta description> y NO declaraba <slot name="head" />, asi que
// cualquier <SeoHead slot="head" .../> o <JsonLd slot="head" .../> pasado
// por paginas como src/pages/paginas/[slug].astro se descartaba en
// silencio -- el build pasaba pero el <title> quedaba vacio y el
// JSON-LD nunca llegaba al HTML final. Ahora el layout expone el slot
// "head" y solo cae al title/description por defecto si la pagina no
// provee los suyos via props o via el slot.
//
// PR D (llms.txt): todas las paginas declaran rel="describedby" hacia
// /llms.txt. markdownUrl (opcional) agrega rel="alternate" text/markdown;
// es una prop y no va por el slot "head" para no reemplazar el <title>.
export interface Props {
  title?: string;
  description?: string;
  markdownUrl?: string;
}
const { title = "Portaless", description = "Sitio construido con Portaless", markdownUrl } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const llmsTxtUrl = `${base}/llms.txt`;
// Phase 6: el feed de los posts publicados se anuncia desde TODAS las
// paginas (no solo /blog), que es como lo encuentran los lectores que no
// conocen el sitio. /api/analytics sigue el mismo patron: un asset que el
// hosting con functions puede reemplazar en runtime.
const rssUrl = `${base}/rss.xml`;
const analyticsUrl = `${base}/api/analytics`;
import "../styles/fonts.css";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="describedby" type="text/plain" href={llmsTxtUrl} />
    <link rel="alternate" type="application/rss+xml" title="Feed RSS" href={rssUrl} />
    {markdownUrl && <link rel="alternate" type="text/markdown" href={markdownUrl} />}
    <!-- Phase 0: hoja del skin activo del sitio. Va despues de global.css
         (que trae la paleta oficial como default) para sobreescribirla.
         En hosting estatico sin functions el 404 lo ignora el navegador
         y manda el default -- nunca rompe la pagina. -->
    <link rel="stylesheet" href={`${base}/api/site-skin`} />
    <!-- Phase 6: analytics del sitio. El asset existe siempre (el build
         emite un no-op si no hay nada configurado) y en hosting con
         functions se genera desde la tabla site_settings en runtime,
         igual que /paginas/[slug]: GitHub Pages se queda con el build. -->
    <script src={analyticsUrl} defer></script>
    <script is:inline>
      // Toggle explicito de tema: localStorage("portaless-theme") =
      // "dark" | "light" fuerza el tema; ausente = auto (SO). Va antes
      // del primer paint para no parpadear.
      try {
        var t = localStorage.getItem("portaless-theme");
        if (t === "dark" || t === "light") document.documentElement.setAttribute("data-theme", t);
      } catch (e) { /* sin storage: auto */ }
    </script>
    <slot name="head">
      <meta name="description" content={description} />
      <title>{title}</title>
    </slot>
  </head>
  <body>
    <Header />
    <main class="container">
      <slot />
    </main>
    <Footer />
  </body>
</html>
