---
// v0.0.8: FIX -- title/description ya no son obligatorios ni tienen
// default fijo. Antes este layout siempre renderizaba su propio
// <title>/<meta description> y NO declaraba <slot name="head" />, asi que
// cualquier <SeoHead slot="head" .../> o <JsonLd slot="head" .../> pasado
// por paginas como src/pages/paginas/[slug].astro se descartaba en
// silencio -- el build pasaba pero el <title> quedaba vacio y el
// JSON-LD nunca llegaba al HTML final. Ahora el layout expone el slot
// "head" y solo cae al title/description por defecto si la pagina no
// provee los suyos via props o via el slot.
//
// PR D (llms.txt): todas las paginas declaran rel="describedby" hacia
// /llms.txt. markdownUrl (opcional) agrega rel="alternate" text/markdown;
// es una prop y no va por el slot "head" para no reemplazar el <title>.
export interface Props {
  title?: string;
  description?: string;
  markdownUrl?: string;
  /**
   * Idioma del documento (<html lang>). Default: SITE_LANG. El home pasa su
   * locale ("en"/"es"); el resto del sitio sigue con SITE_LANG.
   */
  lang?: string;
  /**
   * Alternates hreflang (i18n, docs/i18n-design.md): enlaces ABSOLUTOS a las
   * otras proyecciones de locale de esta misma pagina. Se emiten como
   * <link rel="alternate" hreflang=...>.
   */
  alternates?: Array<{ hreflang: string; href: string }>;
  /**
   * Ruta canonica (sin prefijo de locale) de esta pagina, para el selector de
   * idioma: el header enlaza a la MISMA ruta en el otro locale. Default "/"
   * (el home), que es el unico destino localizado ademas de Explore.
   */
  alternatePath?: string;
  /**
   * Tema por pagina (theme pack) ya resuelto: nombre + la declaracion de
   * variables que themeStyleDecl() construye. Lo pasa
   * src/pages/paginas/[slug].astro; sin el, la pagina usa el skin del
   * sitio como siempre. Ver packages/atomic-elements/src/themes/theme-pack.ts.
   */
  pageTheme?: { name: string; css: string };
  /**
   * Atomic Icons Responsive: contexto del rincon del header (carrito en
   * tiendas, volumen en videos, null = solo Share). Lo deriva
   * deriveHeaderContext() desde el arbol de elementos de la pagina.
   */
  headerContext?: import("../lib/atomic-responsive-icons").HeaderContext;
}
const { title = "Portaless", description = "Sitio construido con Portaless", markdownUrl, lang = SITE_LANG, alternates = [], alternatePath = "/", pageTheme, headerContext = null } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const llmsTxtUrl = `${base}/llms.txt`;
// Phase 6: el feed de los posts publicados se anuncia desde TODAS las
// paginas (no solo /blog), que es como lo encuentran los lectores que no
// conocen el sitio. /api/analytics sigue el mismo patron: un asset que el
// hosting con functions puede reemplazar en runtime.
const rssUrl = `${base}/rss.xml`;
const analyticsUrl = `${base}/api/analytics`;
import "../styles/fonts.css";
import "../styles/global.css";
import Header from "../components/Header.astro";
import { SITE_LANG } from "../lib/site-lang";
import { isLocale } from "../lib/i18n";
import Footer from "../components/Footer.astro";
import { VOLUME_LISTENER_SCRIPT } from "../lib/atomic-responsive-icons";
---
<!doctype html>
<!-- Tema por pagina: las variables van como atributo style EN <html>, no
     como regla de hoja. Motivo verificado en el build:
     Astro inyecta el <link> de global.css (bloque @media oscuro, misma
     especificidad 0,2,0) DESPUES del contenido estatico del head, asi
     que cualquier selector perderia el empate por orden en sistemas en
     modo oscuro. Un atributo style inline gana a cualquier regla de
     hoja, siempre, sin !important. Solo lleva las variables del pack;
     el resto sigue viniendo del skin del sitio. -->
<html lang={lang} data-theme-pack={pageTheme?.name} style={pageTheme?.css || undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="describedby" type="text/plain" href={llmsTxtUrl} />
    <link rel="alternate" type="application/rss+xml" title="Feed RSS" href={rssUrl} />
    {alternates.map((alt) => (
      <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
    ))}
    {markdownUrl && <link rel="alternate" type="text/markdown" href={markdownUrl} />}
    <!-- Phase 0: hoja del skin activo del sitio. Va despues de global.css
         (que trae la paleta oficial como default) para sobreescribirla.
         En hosting estatico sin functions el 404 lo ignora el navegador
         y manda el default -- nunca rompe la pagina. -->
    <link rel="stylesheet" href={`${base}/api/site-skin`} />
    <!-- Phase 6: analytics del sitio. El asset existe siempre (el build
         emite un no-op si no hay nada configurado) y en hosting con
         functions se genera desde la tabla site_settings en runtime,
         igual que /paginas/[slug]: GitHub Pages se queda con el build. -->
    <script src={analyticsUrl} defer></script>
    <script is:inline>
      // Toggle explicito de tema: localStorage("portaless-theme") =
      // "dark" | "light" fuerza el tema; ausente = auto (SO). Va antes
      // del primer paint para no parpadear.
      try {
        var t = localStorage.getItem("portaless-theme");
        if (t === "dark" || t === "light") document.documentElement.setAttribute("data-theme", t);
      } catch (e) { /* sin storage: auto */ }
    </script>
    <script is:inline>
      // Boton "Compartir" de las paginas bio (ProfileHeader). Listener
      // DELEGADO: el HTML de los elementos es estatico y no trae
      // handlers inline, asi que esto sigue funcionando si alguna vez se
      // agrega Content-Security-Policy. Web Share API si existe (movil);
      // si no, copia la URL al portapapeles y avisa con un toast.
      document.addEventListener("click", async function (e) {
        var t = e.target;
        var el = t && t.closest ? t.closest("[data-portaless-share]") : null;
        if (!el) return;
        e.preventDefault();
        var url = location.href;
        if (navigator.share) {
          try { await navigator.share({ title: document.title, url: url }); return; }
          catch (err) { if (err && err.name === "AbortError") return; }
        }
        try {
          await navigator.clipboard.writeText(url);
          var toast = document.createElement("div");
          toast.textContent = "Enlace copiado";
          toast.setAttribute("role", "status");
          toast.style.cssText = "position:fixed;left:50%;bottom:20px;transform:translateX(-50%);background:#261C15;color:#fff;padding:8px 16px;border-radius:999px;font-size:0.85rem;z-index:99;box-shadow:0 6px 20px rgba(0,0,0,.25);";
          document.body.appendChild(toast);
          setTimeout(function () { toast.remove(); }, 1800);
        } catch (err) { /* sin clipboard (contexto no seguro): nada que romper */ }
      });
    </script>
    <!-- Atomic Icons Responsive: control de volumen del rincon del
         header (solo se emite el boton en paginas con Video). Mismo
         patron que el share: listener DELEGADO, sin handlers inline,
         embebido desde el modulo compartido con el shell runtime. -->
    <script is:inline set:html={VOLUME_LISTENER_SCRIPT} />
    <slot name="head">
      <meta name="description" content={description} />
      <title>{title}</title>
    </slot>
  </head>
  <body>
    <Header context={headerContext} locale={isLocale(lang) ? lang : SITE_LANG} alternatePath={alternatePath} />
    <main class="container">
      <slot />
    </main>
    <Footer />
  </body>
</html>
