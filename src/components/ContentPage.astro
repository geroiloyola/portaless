---
// Vista compartida de una pagina de contenido (una VERSION: primaria o
// traduccion). La usan las dos rutas -- /paginas/[slug] (primaria) y
// /[locale]/paginas/[slug] (traduccion) -- para que no driftén.
//
// Emite <html lang> del idioma real de la version, los hreflang de las demas
// versiones de la MISMA pagina y, si hay una version en otro idioma, el
// alternate que el header convierte en el selector (misma pagina, otro idioma;
// nunca un salto al home).
import BaseLayout from "../layouts/BaseLayout.astro";
import PageRenderer from "../../packages/atomic-elements/astro-integration/PageRenderer.astro";
import JsonLd from "../../packages/atomic-elements/astro-integration/JsonLd.astro";
import SeoHead from "./SeoHead.astro";
import { getSiteUrl } from "../lib/seo";
import { versionHref, type ContentPage, type PageVersion } from "../lib/content-pages";
import {
  BUILTIN_THEMES,
  resolveThemePack,
  themeStyleDecl,
} from "../../packages/atomic-elements/src/themes/theme-pack";
import { deriveHeaderContext } from "../lib/atomic-responsive-icons";
import type { PublicRevisionHistory } from "../../packages/atomic-elements/src/persistence/public-revision-history";

interface Props {
  page: ContentPage;
  version: PageVersion;
}
const { page, version } = Astro.props;
const layout = version.layout;

const base = import.meta.env.BASE_URL;
const siteUrl = getSiteUrl(Astro.site);

const resolvedTheme = layout.theme ? resolveThemePack(BUILTIN_THEMES, layout.theme) : null;
const pageTheme = resolvedTheme ? { name: resolvedTheme.name, css: themeStyleDecl(resolvedTheme) } : undefined;
const headerContext = deriveHeaderContext(layout.root);

const canonicalUrl = `${siteUrl}${versionHref(version, base)}`;
// hreflang de TODAS las versiones de esta misma pagina (incluida la actual).
const alternates = page.versions.map((v) => ({
  hreflang: v.locale,
  href: `${siteUrl}${versionHref(v, base)}`,
}));
// La version en OTRO idioma, si existe: es el selector del header. Si no hay,
// el header muestra el aviso (no un enlace a otro sitio).
const other = page.versions.find((v) => v.locale !== version.locale);
const languageAlternate = other
  ? { hreflang: other.locale, href: versionHref(other, base) }
  : undefined;

const pageTitle = layout.title ?? layout.slug;
const pageDescription = layout.description ?? "";
const siteInfo = { name: pageTitle, url: siteUrl, base, inLanguage: version.locale };
const revisionHistoryModules = import.meta.glob<{ default: PublicRevisionHistory }>("../content/revision-history/*.json", { eager: true });
const revisionHistory = layout.publicationId
  ? Object.values(revisionHistoryModules).map((module) => module.default).find((history) => history.publicationId === layout.publicationId)
  : undefined;
---

<BaseLayout
  pageTheme={pageTheme}
  headerContext={headerContext}
  lang={version.locale}
  alternates={alternates}
  languageAlternate={languageAlternate}
>
  <SeoHead
    slot="head"
    title={pageTitle}
    description={pageDescription}
    canonicalUrl={canonicalUrl}
  />
  <JsonLd slot="head" layout={layout} site={siteInfo} />
  <PageRenderer layout={layout} />
  {revisionHistory && (
    <section class="public-revision-history" aria-labelledby="revision-history-title">
      <h2 id="revision-history-title">Historial público de revisiones</h2>
      <p>Los cambios se comparan entre revisiones aprobadas. No implican que un cambio haya causado un resultado de reputación.</p>
      <ol>
        {revisionHistory.revisions.map((revision) => (
          <li>
            <h3>Revisión {revision.revisionNo}: {revision.title}</h3>
            <p><time datetime={revision.publishedAt}>{new Date(revision.publishedAt).toLocaleString(version.locale)}</time></p>
            <p><code>{revision.contentHash}</code></p>
            {revision.changedPaths.length > 0
              ? <p>Cambios verificables: {revision.changedPaths.join(", ")}</p>
              : <p>Primera revisión pública registrada.</p>}
            {revision.reputation.status === "no_data"
              ? <p>Reputación ligada a esta revisión: sin datos.</p>
              : (
                <div>
                  <h4>Evidencia asociada a esta revisión</h4>
                  <ul>
                    {revision.reputation.observations.map((observation) => (
                      <li>
                        <time datetime={observation.observedAt}>{new Date(observation.observedAt).toLocaleString(version.locale)}</time>
                        {" — "}{observation.source}; reglas {observation.rulesVersion}
                        {observation.sampleSize !== null && `; muestra ${observation.sampleSize}`}
                        {observation.weight !== null && `; peso ${observation.weight}`}
                        <pre><code>{JSON.stringify(observation.calculation, null, 2)}</code></pre>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
          </li>
        ))}
      </ol>
      <a href={`${base}revisions/${revisionHistory.publicationId}/index.json`}>Consultar y verificar el historial completo (JSON)</a>
    </section>
  )}
</BaseLayout>

<style is:global>
  .public-revision-history { margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--panel-border); overflow-wrap: anywhere; }
  .public-revision-history li { margin: 1.25rem 0; }
  .public-revision-history code { overflow-wrap: anywhere; }
</style>
