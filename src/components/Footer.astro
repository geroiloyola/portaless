---
// Footer del ecosistema Portaless -- dos filas con trabajos distintos:
//
//   1. Ecosistema  -> TrustScore (confianza verificable), Explore
//      (descubrimiento de la red) y Powered by Portaless (atribucion --
//      en un producto open source el "powered by" es de facto
//      obligatorio y es ademas la puerta de entrada a la comunidad).
//   2. Posicion    -> "Open Source, Modular, Agent-Ready & Zero-Hosting":
//      la promesa del producto en cuatro palabras, exactamente. Es la
//      linea que hace creible el "Powered by" de la fila 1.
//
// NOTA (SITE_ID): el hub /trust/ resuelve el siteId por defecto del sitio
// ("default", el unico que existe hoy) cuando la URL no trae uno, asi que el
// enlace funciona en el deploy estatico sin conocer el id. El endpoint JSON
// sigue siendo /trust/<siteId> (functions/).
const trustHref = `${import.meta.env.BASE_URL}trust/`;
const exploreHref = `${import.meta.env.BASE_URL}explore/`;
const repoHref = "https://github.com/geroiloyola/portaless";
---
<footer class="site-footer">
  <div class="container">
    <nav class="footer-eco" aria-label="Ecosistema Portaless">
      <a href={trustHref}>TrustScore</a>
      <span class="sep" aria-hidden="true">·</span>
      <a href={exploreHref}>Explore</a>
      <span class="sep" aria-hidden="true">·</span>
      <a href={repoHref} target="_blank" rel="noopener noreferrer">Powered by Portaless</a>
    </nav>
    <p class="footer-note">
      Open Source, Modular, Agent-Ready & Zero-Hosting
    </p>
  </div>
</footer>
