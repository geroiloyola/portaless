      confidence: "Ordenado por límite inferior de Wilson sobre señales verificadas del nodo.",
      history: "Ordenado por estabilidad longitudinal y recurrencia de testigos del nodo.",
    },
    chips: { documentation: "Documentation", demoPages: "Demo Pages", demoShops: "Demo Shops", demoProfiles: "Demo Profiles", pages: "Páginas", shops: "Tiendas", profiles: "Perfiles", publications: "Publications" },
