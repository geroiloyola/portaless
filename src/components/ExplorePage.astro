    aboutSourceValue: "contenido local de este sitio (build).",
    aboutAsOf: "asOf:",
    aboutWindow: "Ventana:",
    aboutWindowValue: (days: number) => `${days} días (solo aplica a top).`,
    aboutNode: "El orden por atestaciones firmadas y observaciones de testigos (top, confidence) se calcula en un nodo con functions/, no en este hosting estático: por eso acá no se finge un ranking.",
    aboutFilters: "Filtros normativos:",
    dateLocale: "es-CL",
  },
} as const;

import { loadContentPages, loadHomeLayout } from "../lib/content-pages";
import { getSiteProfileConfig } from "../lib/site-profile.mjs";

const profile = getSiteProfileConfig(process.env);
const c = COPY[locale];
const base = import.meta.env.BASE_URL;
const pageTheme = ecosystemPageTheme();
const homeLayout = loadHomeLayout(profile.id, locale === "es" && profile.features.esRoutes ? "es" : "en");

const pages = loadContentPages(profile.id)
  .map((entry) => entry.primary.layout)
  .sort((a, b) => a.slug.localeCompare(b.slug));

const posts = publishedPosts(await getCollection("posts"));

function flatten(nodes: ElementNode[]): ElementNode[] {
  return nodes.flatMap((n) => [
    n,
    ...(n.children ? flatten(n.children) : []),
    ...(n.columnSlots ? n.columnSlots.flatMap(flatten) : []),
  ]);
}
function kindOf(page: PageLayout): "profile" | "shop" | "page" {
  const flat = flatten(page.root);
  if (flat.some((n) => n.type === "ProfileHeader")) return "profile";
  if (flat.some((n) => n.type === "StoreBlock" || n.type === "ProductGrid" || n.type === "ProductCard")) return "shop";
  return "page";
}
const demoPages = pages.filter((p) => kindOf(p) === "page");
const demoShops = pages.filter((p) => kindOf(p) === "shop");
const demoProfiles = pages.filter((p) => kindOf(p) === "profile");

// Docs: ahora son paginas del propio sitio (/docs/), no enlaces a GitHub.
// La fuente sigue siendo el Markdown de docs/ (el sitio es su proyeccion), asi
// que estos destacados apuntan a la ruta interna. "Architecture" no tiene un
// doc exacto publicado; se apunta al doc de arquitectura del ecosistema.
const DOC_KEY: Record<string, string> = {
  "Install in 10 minutes": "/docs/first-steps/",
  "Self-hosting": "/docs/self-hosting/",
  "Protocol APW": "/docs/protocol-apw/",
  Architecture: "/docs/ecosystem-boundaries/",
};
const DOC_HREF: Record<string, string> = {
  "Install in 10 minutes": `${base}docs/first-steps/`,
  "Self-hosting": `${base}docs/self-hosting/`,
  "Protocol APW": `${base}docs/protocol-apw/`,
  Architecture: `${base}docs/ecosystem-boundaries/`,
};

const exploreEndpoint = `${base}explore.json`;
const trustHref = `${base}trust/`;
const repoHref = "https://github.com/geroiloyola/portaless";
const buildAsOf = new Date().toISOString();
const windowDays = 30;
const RANKING_FILTERS = ["top", "confidence", "recents", "new", "old", "history"] as const;
const notesJson = JSON.stringify({ local: c.status, node: c.nodeStatus });
const exploreDescription = profile.isDemo ? c.description : c.starterDescription;
const exploreIntro = profile.isDemo ? c.intro : c.starterIntro;
const pagesLabel = profile.isDemo ? c.chips.demoPages : c.chips.pages;
const shopsLabel = profile.isDemo ? c.chips.demoShops : c.chips.shops;
const profilesLabel = profile.isDemo ? c.chips.demoProfiles : c.chips.profiles;
const scopeLabelText = locale === "es" ? "Ámbito" : "Scope";
const allScopeLabel = locale === "es" ? "Todo" : "All";

interface FlairItem {
  slug: string;
  label: string;
}

function normalizeFlairSlug(label: string): string {
  return label
    .trim()
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "");
}

const flairCatalog = new Map<string, string>();
function registerFlairs(rawList: readonly unknown[]): FlairItem[] {
  const seen = new Set<string>();
  const items: FlairItem[] = [];
  for (const raw of rawList) {
    if (typeof raw !== "string") continue;
    const label = raw.trim();
    if (!label) continue;
    const slug = normalizeFlairSlug(label);
    if (!slug || seen.has(slug)) continue;
    seen.add(slug);
    if (!flairCatalog.has(slug)) flairCatalog.set(slug, label);
    items.push({ slug, label: flairCatalog.get(slug)! });
  }
  return items;
}

const homeFlairs = homeLayout ? registerFlairs(homeLayout.flairs ?? []) : [];
const pageFlairsMap = new Map<string, FlairItem[]>();
for (const page of pages) {
  pageFlairsMap.set(page.slug, registerFlairs(page.flairs ?? []));
}
const postFlairsMap = new Map<string, FlairItem[]>();
for (const post of posts) {
  const raw = [
    ...(Array.isArray(post.data.flairs) ? post.data.flairs : []),
    ...(typeof post.data.flair === "string" ? [post.data.flair] : []),
    ...(Array.isArray(post.data.tags) ? post.data.tags : []),
  ];
  postFlairsMap.set(post.id, registerFlairs(raw));
}

const flairItems: FlairItem[] = Array.from(flairCatalog.entries()).map(([slug, label]) => ({ slug, label }));

// 3 ambitos base obligatorios en orden: Todo -> Paginas -> Publications.
// En perfil demo se conservan ademas las secciones demo activas si existen.
const scopeItems: Array<{ value: string; label: string }> = [
  { value: "all", label: allScopeLabel },
  { value: "pages", label: pagesLabel },
  { value: "publications", label: c.chips.publications },
  ...(profile.features.docs ? [{ value: "documentation", label: c.chips.documentation }] : []),
  ...(demoShops.length > 0 ? [{ value: "shops", label: shopsLabel }] : []),
  ...(demoProfiles.length > 0 ? [{ value: "profiles", label: profilesLabel }] : []),
];
---

<BaseLayout title={c.title} description={exploreDescription} pageTheme={pageTheme} lang={locale} alternatePath={profile.features.esRoutes ? "/explore/" : undefined}>
  <h1>{c.heading}</h1>
  <p class="explore-intro">{exploreIntro}</p>

  <div class="explore-scope">
    <span class="explore-order-label">{scopeLabelText}</span>
    <div class="explore-order-pills" role="radiogroup" aria-label={scopeLabelText}>
      {scopeItems.map((s) => (
        <label class="explore-order-pill">
          <input type="radio" name="explore-scope" value={s.value} data-scope-label={s.label} checked={s.value === "all"} />
          <span>{s.label}</span>
        </label>
      ))}
      {flairItems.length > 0 && <span class="explore-scope-divider" aria-hidden="true"></span>}
      {flairItems.map((f) => (
        <label class="explore-order-pill explore-flair-pill">
          <input type="radio" name="explore-scope" value={`flair:${f.slug}`} data-scope-label={f.label} />
          <span>{f.label}</span>
        </label>
      ))}
    </div>
  </div>

  <div class="explore-order" data-explore-endpoint={exploreEndpoint}>
    <span class="explore-order-label">{c.orderBy}</span>
    <div class="explore-order-pills" role="radiogroup" aria-label={c.orderBy}>
      {RANKING_FILTERS.map((f) => (
        <label class="explore-order-pill">
          <input type="radio" name="explore-order" value={f} checked={f === "new"} />
          <span>{f}</span>
        </label>
      ))}
    </div>
  </div>
  <p class="explore-order-status" id="explore-order-status" role="status"></p>
  <script type="application/json" id="explore-order-notes" set:html={notesJson} />

  {!profile.isDemo && (
    <section id="site-home" data-explore-section="home">
      <h2>Home</h2>
      <div class="explore-grid">
        <a class="explore-card" href={base} data-explore-key="/" data-order={buildAsOf} data-flairs={homeFlairs.map((f) => f.slug).join(",")}>
          <h3>{homeLayout.title || "Home"}</h3>
          {homeLayout.description && <p>{homeLayout.description}</p>}
          {homeFlairs.length > 0 && (
            <div class="explore-card-flairs">
              {homeFlairs.map((f) => <span class="explore-flair-badge">{f.label}</span>)}
            </div>
          )}
        </a>
      </div>
    </section>
  )}

  {profile.features.docs && (
    <section id="documentation" data-explore-section="documentation">
      <h2>{c.docsHeading}</h2>
      <div class="explore-grid">
        {c.docs.map((doc, idx) => (
          <a class="explore-card" href={DOC_HREF[doc.title]} data-explore-key={DOC_KEY[doc.title]} data-order={`doc-${String(idx).padStart(4, "0")}`} data-flairs="">
            <h3>{doc.title}</h3>
            <p>{doc.note}</p>
          </a>
        ))}
      </div>
    </section>
  )}

  {demoPages.length > 0 && (
    <section id={profile.isDemo ? "demo-pages" : "pages"} data-explore-section="pages">
      <h2>{pagesLabel}</h2>
      <div class="explore-grid">
        {demoPages.map((page, idx) => {
          const cardFlairs = pageFlairsMap.get(page.slug) ?? [];
          return (
            <a class="explore-card" href={contentPageHref(page.slug, undefined, base)} data-explore-key={contentPageHref(page.slug, undefined, "/")} data-order={`page-${String(idx).padStart(4, "0")}-${page.slug}`} data-flairs={cardFlairs.map((f) => f.slug).join(",")}>
              <h3>{page.title || page.slug}</h3>
              {page.description && <p>{page.description}</p>}
              {cardFlairs.length > 0 && (
                <div class="explore-card-flairs">
                  {cardFlairs.map((f) => <span class="explore-flair-badge">{f.label}</span>)}
                </div>
              )}
            </a>
          );
        })}
      </div>
    </section>
  )}

  {demoShops.length > 0 && (
    <section id={profile.isDemo ? "demo-shops" : "shops"} data-explore-section="shops">
      <h2>{shopsLabel}</h2>
      <div class="explore-grid">
        {demoShops.map((page, idx) => (
          <a class="explore-card" href={contentPageHref(page.slug, undefined, base)} data-explore-key={contentPageHref(page.slug, undefined, "/")} data-order={`shop-${String(idx).padStart(4, "0")}`} data-flairs="">
            <h3>{page.title || page.slug}</h3>
            {page.description && <p>{page.description}</p>}
          </a>
        ))}
      </div>
    </section>
  )}

  {demoProfiles.length > 0 && (
    <section id={profile.isDemo ? "demo-profiles" : "profiles"} data-explore-section="profiles">
      <h2>{profilesLabel}</h2>
      <div class="explore-grid">
        {demoProfiles.map((page, idx) => (
          <a class="explore-card" href={contentPageHref(page.slug, undefined, base)} data-explore-key={contentPageHref(page.slug, undefined, "/")} data-order={`profile-${String(idx).padStart(4, "0")}`} data-flairs="">
            <h3>{page.title || page.slug}</h3>
            {page.description && <p>{page.description}</p>}
          </a>
        ))}
      </div>
    </section>
  )}

  {posts.length > 0 && (
    <section id="publications" data-explore-section="publications">
      <h2>{c.chips.publications}</h2>
      <div class="explore-grid">
        {posts.map((post) => {
          const cardFlairs = postFlairsMap.get(post.id) ?? [];
          return (
            <a class="explore-card" href={`${base}blog/${post.id}/`} data-explore-key={`/blog/${post.id}/`} data-order={post.data.pubDate.toISOString()} data-flairs={cardFlairs.map((f) => f.slug).join(",")}>
              <h3>{post.data.title}</h3>
              <p class="explore-card-meta">{post.data.pubDate.toLocaleDateString(c.dateLocale)}</p>
              {post.data.description && <p>{post.data.description}</p>}
              {cardFlairs.length > 0 && (
                <div class="explore-card-flairs">
                  {cardFlairs.map((f) => <span class="explore-flair-badge">{f.label}</span>)}
                </div>
              )}
            </a>
          );
        })}
      </div>
    </section>
  )}

  {profile.features.projections && (
    <section id="how">
      <h2>{c.howHeading}</h2>
      <div class="explore-grid">
        <a class="explore-card" href={`${base}projections/`} data-explore-key="/projections/">
          <h3>{c.howTitle}</h3>
          <p>{c.howNote}</p>
        </a>
      </div>
    </section>
  )}

  <section id="network">
    <h2>{c.networkHeading}</h2>
    <div class="explore-grid">
      <a class="explore-card" href={trustHref} data-explore-key="/trust/">
        <h3>{c.trustTitle}</h3>
        <p>{c.trustNote}</p>
      </a>
      <a class="explore-card" href={repoHref} target="_blank" rel="noopener noreferrer">
        <h3>{c.repoTitle}</h3>
        <p>{c.repoNote}</p>
      </a>
    </div>
  </section>

  <details class="explore-about" data-explore-source="local">
    <summary>{c.aboutSummary}</summary>
    <p>
      <strong>{c.aboutSource}</strong> {c.aboutSourceValue}
      <strong>{c.aboutAsOf}</strong> <time datetime={buildAsOf}>{buildAsOf}</time>.
      <strong>{c.aboutWindow}</strong> {c.aboutWindowValue(windowDays)}
      {c.aboutNode}
      {c.aboutFilters} {RANKING_FILTERS.join(", ")}.
    </p>
  </details>
</BaseLayout>

<script>
  interface NodeScoreEntry {
    top: number;
    confidence: number;
    history: number;
    signals: number;
  }

  interface ExploreNotesPayload {
    local?: Record<string, string>;
    node?: Record<string, string>;
  }

  const notesEl = document.getElementById("explore-order-notes");
  const parsedNotes: ExploreNotesPayload = notesEl ? JSON.parse(notesEl.textContent || "{}") : {};
  const LOCAL_NOTES: Record<string, string> = parsedNotes.local ?? {};
  const NODE_NOTES: Record<string, string> = parsedNotes.node ?? {};
  const status = document.getElementById("explore-order-status");
  const aboutEl = document.querySelector<HTMLElement>(".explore-about");

  let activeScope = "all";
  let activeScopeLabel = "";
  let activeCriterion = "new";
  let hasNodeSignals = false;

  function normalizeExploreKey(raw: string | null): string | null {
    if (!raw) return null;
    let value = raw.trim();
    if (!value) return null;
    if (/^https?:\/\//i.test(value)) {
      try {
        value = new URL(value).pathname;
      } catch {
        return null;
      }
    }
    if (value.startsWith("/") || value.includes("/")) {
      const withLeading = value.startsWith("/") ? value : `/${value}`;
      const collapsed = withLeading.replace(/\/{2,}/g, "/");
      if (collapsed === "/") return "/";
      return collapsed.endsWith("/") ? collapsed : `${collapsed}/`;
    }
    return value.toLowerCase();
  }

  function syncUrl(pushHistory: boolean): void {
    if (!pushHistory || typeof window.history?.replaceState !== "function") return;
    const params = new URLSearchParams(window.location.search);
    params.delete("flair");
    params.delete("scope");
    params.delete("order");
    if (activeScope.startsWith("flair:")) {
      params.set("flair", activeScope.slice("flair:".length));
    } else if (activeScope !== "all") {
      params.set("scope", activeScope);
    }
    if (activeCriterion !== "new") {
      params.set("order", activeCriterion);
    }
    const qs = params.toString();
    const nextUrl = qs ? `${window.location.pathname}?${qs}` : window.location.pathname;
    window.history.replaceState(null, "", nextUrl);
  }

  function applyScope(scope: string, label: string, pushHistory = true): void {
    activeScope = scope;
    activeScopeLabel = label;
    const isFlair = scope.startsWith("flair:");
    const targetFlair = isFlair ? scope.slice("flair:".length) : "";

    document.querySelectorAll<HTMLElement>("section[data-explore-section]").forEach((sec) => {
      const secName = sec.getAttribute("data-explore-section") || "";
      const cards = Array.from(sec.querySelectorAll<HTMLElement>(".explore-card"));

      if (isFlair) {
        let visibleCount = 0;
        cards.forEach((card) => {
          const flairs = (card.getAttribute("data-flairs") || "").split(",").filter(Boolean);
          const match = flairs.includes(targetFlair);
          card.hidden = !match;
          if (match) visibleCount += 1;
        });
        sec.hidden = visibleCount === 0;
      } else {
        cards.forEach((card) => {
          card.hidden = false;
        });
        const matchesPages = scope === "pages" && (secName === "pages" || secName === "home");
        sec.hidden = scope !== "all" && secName !== scope && !matchesPages;
      }
    });

    reorder(activeCriterion, pushHistory);
  }

  function reorder(criterion: string, pushHistory = true): void {
    activeCriterion = criterion;
    const desc = criterion === "new" || criterion === "recents";
    const asc = criterion === "old";
    const applyDate = desc || asc;
    const isNodeMetric = criterion === "top" || criterion === "confidence" || criterion === "history";
    const applyNode = hasNodeSignals && isNodeMetric;

    document.querySelectorAll(".explore-grid").forEach((grid) => {
      const parentSection = grid.closest("section");
      if (parentSection && parentSection.hidden) return;
      const cards = Array.from(grid.children) as HTMLElement[];
      cards.forEach((card, i) => {
        if (!card.hasAttribute("data-idx")) card.setAttribute("data-idx", String(i));
      });
      cards.sort((a, b) => {
        if (applyNode) {
          const sa = Number(a.getAttribute(`data-score-${criterion}`) || 0);
          const sb = Number(b.getAttribute(`data-score-${criterion}`) || 0);
          if (sb !== sa) return sb - sa;
          const sigA = Number(a.getAttribute("data-score-signals") || 0);
          const sigB = Number(b.getAttribute("data-score-signals") || 0);
          if (sigB !== sigA) return sigB - sigA;
          const da = a.getAttribute("data-order");
          const db = b.getAttribute("data-order");
          if (da && db && db !== da) return db.localeCompare(da);
          return Number(a.getAttribute("data-idx")) - Number(b.getAttribute("data-idx"));
        }
        const da = a.getAttribute("data-order");
        const db = b.getAttribute("data-order");
        if (applyDate && da && db) return desc ? db.localeCompare(da) : da.localeCompare(db);
        return Number(a.getAttribute("data-idx")) - Number(b.getAttribute("data-idx"));
      });
      cards.forEach((card) => grid.appendChild(card));
    });

    if (status) {
      const note = (hasNodeSignals && NODE_NOTES[criterion]) || LOCAL_NOTES[criterion] || "";
      status.textContent = activeScopeLabel && note ? `${activeScopeLabel} — ${note}` : note;
    }

    syncUrl(pushHistory);
  }

  function hydrateNodeScores(payload: unknown): void {
    if (!payload || typeof payload !== "object") return;
    const data = payload as { source?: string; hasSignals?: boolean; items?: Record<string, NodeScoreEntry> };
    if (data.source !== "node" || data.hasSignals !== true || !data.items || typeof data.items !== "object") {
      return;
    }

    const scoreMap = new Map<string, NodeScoreEntry>();
    for (const [rawKey, entry] of Object.entries(data.items)) {
      const key = normalizeExploreKey(rawKey);
      if (key && entry && typeof entry === "object") {
        scoreMap.set(key, entry);
      }
    }
    if (scoreMap.size === 0) return;

    hasNodeSignals = true;
    document.querySelectorAll<HTMLElement>(".explore-card").forEach((card) => {
      const key = normalizeExploreKey(card.getAttribute("data-explore-key") || card.getAttribute("href"));
      if (!key) return;
      const scores = scoreMap.get(key);
      if (!scores) return;
      card.setAttribute("data-score-top", String(scores.top ?? 0));
      card.setAttribute("data-score-confidence", String(scores.confidence ?? 0));
      card.setAttribute("data-score-history", String(scores.history ?? 0));
      card.setAttribute("data-score-signals", String(scores.signals ?? 0));
    });

    if (aboutEl) {
      aboutEl.setAttribute("data-explore-source", "node");
    }

    reorder(activeCriterion, false);
  }

  const scopeInputs = Array.from(document.querySelectorAll<HTMLInputElement>('input[name="explore-scope"]'));
  const orderInputs = Array.from(document.querySelectorAll<HTMLInputElement>('input[name="explore-order"]'));

  const urlParams = new URLSearchParams(window.location.search);
  const flairParam = urlParams.get("flair");
  const scopeParam = urlParams.get("scope");
  const orderParam = urlParams.get("order");

  const desiredScopeValue = flairParam ? `flair:${flairParam}` : (scopeParam || "all");
  const matchedScope = scopeInputs.find((el) => el.value === desiredScopeValue);
  if (matchedScope) matchedScope.checked = true;

  if (orderParam) {
    const matchedOrder = orderInputs.find((el) => el.value === orderParam);
    if (matchedOrder) matchedOrder.checked = true;
  }

  scopeInputs.forEach((el) => {
    el.addEventListener("change", () => applyScope(el.value, el.getAttribute("data-scope-label") || el.value, true));
  });

  orderInputs.forEach((el) => {
    el.addEventListener("change", () => reorder(el.value, true));
  });

  const initialScope = scopeInputs.find((el) => el.checked) ?? scopeInputs[0];
  const initialOrder = orderInputs.find((el) => el.checked) ?? orderInputs[0];
  if (initialOrder) activeCriterion = initialOrder.value;
  if (initialScope) {
    applyScope(initialScope.value, initialScope.getAttribute("data-scope-label") || initialScope.value, false);
  } else {
    reorder(activeCriterion, false);
  }

  const endpoint = document.querySelector<HTMLElement>("[data-explore-endpoint]")?.getAttribute("data-explore-endpoint");
  if (endpoint && typeof fetch === "function") {
    fetch(endpoint, { headers: { Accept: "application/json" } })
      .then((res) => (res.ok ? res.json() : null))
      .then((data) => {
        if (data) hydrateNodeScores(data);
      })
      .catch(() => {
        // Silent progressive fallback to local ordering on static hosts or offline.
      });
  }
</script>

