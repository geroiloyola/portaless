---
// Vista compartida del home (docs/design/home-redesign.md + docs/i18n-design.md).
// Las dos proyecciones de locale la usan: src/pages/index.astro (en) y
// src/pages/es/index.astro (es). El contenido es un PageLayout JSON; aca solo
// se resuelve el tema, se inyectan los datos de build y se emite el head
// (SEO + hreflang).
import BaseLayout from "../layouts/BaseLayout.astro";
import JsonLd from "../../packages/visual-elements/astro-integration/JsonLd.astro";
import SeoHead from "../components/SeoHead.astro";
import { getCollection } from "astro:content";
import { renderPage } from "@portaless/visual-elements/render";
import {
  BUILTIN_THEMES,
  hasDualMode,
  resolveThemePack,
  themeStyleDecl,
  themeStyleDeclForMode,
} from "@portaless/visual-elements/themes";
import { deriveHeaderContext } from "../lib/atomic-responsive-icons";
import { getSiteUrl } from "../lib/seo";
import { joinSiteUrl, publishedPosts } from "../lib/llms-txt";
import { prepareHome } from "../lib/home";
import {
  DEFAULT_LOCALE,
  hreflangAlternates,
  localePath,
  type Locale,
} from "../lib/i18n";
import type { PageLayout } from "@portaless/visual-elements/types";

interface Props {
  layout: PageLayout;
  locale: Locale;
  /** Ruta canonica sin prefijo de locale (el home es "/"). */
  canonPath: string;
}
const { layout, locale, canonPath } = Astro.props;

const base = import.meta.env.BASE_URL;
const commerceEnabled = import.meta.env.ENABLE_COMMERCE === "true";
const siteUrl = getSiteUrl(Astro.site);
const absolute = (path: string) => joinSiteUrl(siteUrl, base, path);

const posts = publishedPosts(await getCollection("posts"));
const postItems = posts.map((post) => ({
  title: post.data.title,
  href: `/blog/${post.id}/`,
  date: post.data.pubDate.toLocaleDateString(locale === "es" ? "es-CL" : "en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
  }),
  description: post.data.description ?? "",
}));

const prepared = prepareHome(layout, postItems, commerceEnabled);

const resolvedTheme = layout.theme ? resolveThemePack(BUILTIN_THEMES, layout.theme) : null;
const pageThemeModes = resolvedTheme && hasDualMode(resolvedTheme)
  ? { lightCss: themeStyleDeclForMode(resolvedTheme, "light"), darkCss: themeStyleDeclForMode(resolvedTheme, "dark") }
  : undefined;
const pageTheme = resolvedTheme
  ? { name: resolvedTheme.name, css: pageThemeModes ? pageThemeModes.lightCss : themeStyleDecl(resolvedTheme) }
  : undefined;
const headerContext = deriveHeaderContext(prepared.root);

const html = await renderPage(prepared, { base });

const canonicalUrl = absolute(localePath(locale, canonPath));
const baseNoSlash = base.replace(/\/$/, "");
const explicitAlt = layout.alternateLang
  ? {
      hreflang: layout.alternateLang.code.toLowerCase(),
      href: `${baseNoSlash}${layout.alternateLang.href}`,
      label: layout.alternateLang.code.toUpperCase(),
      compact: true,
    }
  : undefined;
const baseAlternates = [
  ...hreflangAlternates(canonPath).map((a) => ({ hreflang: a.hreflang, href: absolute(a.path) })),
  { hreflang: "x-default", href: absolute(localePath(DEFAULT_LOCALE, canonPath)) },
];
const alternates = explicitAlt && !baseAlternates.some((a) => a.hreflang === explicitAlt.hreflang)
  ? [...baseAlternates, { hreflang: explicitAlt.hreflang, href: absolute(layout.alternateLang!.href) }]
  : baseAlternates;
---

<BaseLayout lang={locale} pageTheme={pageTheme} pageThemeModes={pageThemeModes} headerContext={headerContext} alternatePath={canonPath} languageAlternate={explicitAlt} alternates={alternates}>
  <SeoHead slot="head" title={layout.title} description={layout.description ?? ""} canonicalUrl={canonicalUrl} />
  <JsonLd slot="head" layout={prepared} site={{ name: layout.title, url: siteUrl, base, inLanguage: locale }} />
  <article class="ae-page ae-home" set:html={html} />
</BaseLayout>

<style is:global>
  /* El home respira mas ancho que una pagina de contenido (860px). Solo el home. */
  main.container {
    max-width: 1080px;
  }
  /* Espaciado entre secciones por GAP (flex), no por margin-top: el margin
     inline de los elementos (margin:0) pisaria la regla de hoja. Un gap
     generoso uniforme; el antetitulo del Heading ahora va dentro del heading,
     asi que el gap no lo separa de su titulo. */
  .ae-home {
    display: flex;
    flex-direction: column;
    gap: 56px;
  }
</style>
