---
import { getCollection } from "astro:content";
import { homeLabel, postsLabel, exploreLabel, SITE_LANG } from "../lib/site-lang";
import { localePath, otherLocale, t, type Locale } from "../lib/i18n";
import {
  headerActionsHtml,
  langSwitcherHtml,
  NAV_ICONS,
  navIconHtml,
  type HeaderContext,
} from "../lib/atomic-responsive-icons";

interface Props {
  // Atomic Icons Responsive: el rincon derecho adapta su icono principal
  // al contenido de la pagina (carrito en tiendas, volumen en videos);
  // null = solo Share. Lo calcula deriveHeaderContext desde el arbol de
  // elementos del PageLayout y lo pasa BaseLayout.
  context?: HeaderContext;
  // Idioma del documento (docs/i18n-design.md): decide las etiquetas del menu
  // (Home/Inicio, Publications/Publicaciones, Explore/Explorar) y el selector
  // de idioma. Default: SITE_LANG.
  locale?: Locale;
  // Ruta canonica sin prefijo de locale (default "/"): el selector de idioma
  // enlaza a la MISMA ruta en el otro locale (home y Explore estan localizados).
  alternatePath?: string;
}
const { context = null, locale = SITE_LANG, alternatePath = "/" } = Astro.props;

const base = import.meta.env.BASE_URL;
const commerceEnabled = import.meta.env.ENABLE_COMMERCE === "true";
// El indice de publicaciones solo se anuncia si hay algo que leer: si el sitio
// no tiene ninguna publicacion no-borrador, el link desaparece en vez de mandar
// al visitante a un indice vacio.
const publishedPosts = (await getCollection("posts")).filter((p) => !p.data.draft);

// Selector de idioma: apunta a la MISMA ruta en el OTRO locale (el home y
// Explore estan localizados; para el resto de las paginas, que aun no lo estan,
// alternatePath cae a "/" y el switcher lleva al home del otro idioma). Muestra
// el nombre del otro idioma, asi el enlace dice a donde va.
const other = otherLocale(locale);
const otherHref = `${base.replace(/\/$/, "")}${localePath(other, alternatePath)}`;
---
<header class="site-header">
  <nav>
    <a class="brand" href={base}>Portaless</a>
    <!-- Cada enlace lleva su icono (visible solo en movil) y su texto (visible
         solo en desktop). El texto SIEMPRE esta en el DOM: en movil se oculta
         visualmente, asi el nombre accesible se conserva. -->
    <a class="nav-link" href={base}>
      <Fragment set:html={navIconHtml(NAV_ICONS.home)} />
      <span class="nav-txt">{homeLabel(locale)}</span>
    </a>
    {publishedPosts.length > 0 && (
      <a class="nav-link" href={`${base}blog/`}>
        <Fragment set:html={navIconHtml(NAV_ICONS.posts)} />
        <span class="nav-txt">{postsLabel(locale)}</span>
      </a>
    )}
    <a class="nav-link" href={`${base}explore/`}>
      <Fragment set:html={navIconHtml(NAV_ICONS.explore)} />
      <span class="nav-txt">{exploreLabel(locale)}</span>
    </a>
    {commerceEnabled && (
      <a class="nav-link" href={`${base}tienda/`}>
        <Fragment set:html={navIconHtml(NAV_ICONS.shop)} />
        <span class="nav-txt">Tienda</span>
      </a>
    )}
    <!-- Grupo derecho: selector de idioma (con icono, se lee como accion) y
         el rincon de iconos. Empujado a la derecha con margin-left:auto, para
         que el idioma quede alineado a la derecha y no entre las etiquetas. -->
    <div class="header-right">
      <Fragment
        set:html={langSwitcherHtml({
          href: otherHref,
          hreflang: other,
          ariaLabel: t(locale, "home.otherLocaleAria"),
          text: t(locale, "home.otherLocaleName"),
        })}
      />
      <!-- Atomic Icons Responsive: share siempre; icono principal segun
           contexto. El HTML sale de UNA sola fuente compartida con el
           shell runtime (src/lib/atomic-responsive-icons.ts). -->
      <Fragment set:html={headerActionsHtml(context, base)} />
    </div>
  </nav>
</header>
