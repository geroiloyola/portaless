---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("posts"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const commerceEnabled = import.meta.env.ENABLE_COMMERCE === "true";
---
<BaseLayout title="Portaless — Inicio">
  <h1>Portaless</h1>
  <p>
    Un sitio simple, rápido y sin hosting pagado. Construido sobre Astro,
    desplegado gratis en GitHub Pages o Cloudflare Pages.
  </p>

  {commerceEnabled && (
    <p>
      <span class="badge">Comercio activado</span> Este sitio tiene una
      <a href={`${import.meta.env.BASE_URL}tienda/`}>tienda</a> conectada vía Medusa/Mercur.
    </p>
  )}

  <h2>Últimas publicaciones</h2>
  {posts.length === 0 && <p class="empty-state">Todavía no hay publicaciones.</p>}
  {posts.map((post) => (
    <div class="card">
      <h3><a href={`${import.meta.env.BASE_URL}blog/${post.slug}/`}>{post.data.title}</a></h3>
      {post.data.description && <p>{post.data.description}</p>}
    </div>
  ))}
</BaseLayout>
