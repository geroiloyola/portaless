---
// /beta (version primaria, espanol). La version en ingles vive en /en/beta/.
// Ambas renderizan la vista compartida BetaPage (sin duplicar el texto).
import BetaPage from "../components/BetaPage.astro";

const base = import.meta.env.BASE_URL;
---

<BetaPage locale="es" alternateHref={`${base}en/beta/`} alternateHreflang="en" />
