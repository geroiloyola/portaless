---
// Ficha de producto /shop/<handle> (canonica, ingles). El catalogo es
// OPCIONAL: si el comercio no esta habilitado o el catalogo no responde en
// build, no se pre-renderiza ninguna ficha (getStaticPaths devuelve []) y la
// entrada sigue siendo el indice /shop/, que ya informa el estado. Si el
// comercio SI esta habilitado pero el handle no existe (o el fetch falla en
// request), la ficha cae a un estado vacio elegante con vuelta a la tienda --
// nunca a un error crudo.
import BaseLayout from "../../layouts/BaseLayout.astro";
import { isCommerceEnabled, fetchProducts, fetchProductByHandle, formatPrice } from "../../commerce/medusa-client";

export async function getStaticPaths() {
  const enabled = (await import("../../commerce/medusa-client")).isCommerceEnabled;
  if (!(await enabled())) return [];
  try {
    const products = await fetchProducts();
    return products.map((p) => ({ params: { handle: p.handle } }));
  } catch {
    // El catalogo no respondio en build: no rompemos el build por un modulo
    // opcional. La tienda (indice) es la que informa el estado.
    return [];
  }
}

const { handle } = Astro.params;
const enabled = await isCommerceEnabled();
let product: Awaited<ReturnType<typeof fetchProductByHandle>> = null;
if (enabled) {
  try {
    product = await fetchProductByHandle(handle as string);
  } catch {
    product = null;
  }
}
const storeHref = `${import.meta.env.BASE_URL}shop/`;
---
<BaseLayout title={product ? `${product.title} — Store` : "Product not found"}>
  {!product && (
    <div class="empty-state">
      <h1>Product not found</h1>
      <p>
        This product is not available. The commerce module may be disabled, the
        catalog may be empty, or the handle no longer exists.
      </p>
      <p><a href={storeHref}>Back to the store</a></p>
    </div>
  )}
  {product && (
    <article>
      {product.thumbnail && <img src={product.thumbnail} alt={product.title} style="max-width: 320px; border-radius: 12px;" />}
      <h1>{product.title}</h1>
      <p class="price">{formatPrice(product)}</p>
      {product.description && <p>{product.description}</p>}
      <p class="badge">
        To buy, this button must link to your Medusa/Mercur store's checkout
        (not included in Portaless by design — see docs/COMMERCE_SETUP.md).
      </p>
    </article>
  )}
</BaseLayout>
