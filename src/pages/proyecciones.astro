---
// Un canon, cinco proyecciones (ROADMAP fase 13, §13.4).
//
// La demo visible del principio de docs/VISION.md: este sitio tiene UN canon
// (un articulo en src/content/posts/) y todo lo que publica hacia afuera es una
// PROYECCION derivada de el. La pagina no afirma que coinciden: las DERIVA con
// los mismos generadores que usan /rss.xml, /llms.txt y /sitemap.xml y compara
// (src/lib/projections.ts). Lo que necesita un nodo (manifiesto firmado, POSSE)
// se marca "requiere nodo" en vez de pintarse en verde.
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { getSiteUrl } from "../lib/seo";
import { publishedPosts } from "../lib/llms-txt";
import {
  canonicalUrl,
  markdownUrl,
  projectionsFor,
  type Canon,
  type ProjectionContext,
} from "../lib/projections";

const base = import.meta.env.BASE_URL;
const siteUrl = getSiteUrl(Astro.site);
const siteName = process.env.PORTALESS_SITE_NAME || "Portaless";
const summary = process.env.PORTALESS_SITE_DESCRIPTION || "Sitio construido con Portaless";
const siteId = (() => {
  try {
    return new URL(siteUrl).host;
  } catch {
    return "default";
  }
})();

// El canon de la demo es el articulo publicado mas reciente. Es uno solo a
// proposito: el principio no se prueba con dos fuentes.
const canonPost = publishedPosts(await getCollection("posts"))[0];

const ctx: ProjectionContext = { siteUrl, base, siteName, summary, siteId };
const canon: Canon | null = canonPost
  ? {
      kind: "post",
      id: canonPost.id,
      source: `src/content/posts/${canonPost.id}.md`,
      title: canonPost.data.title,
      description: canonPost.data.description ?? "",
      pubDate: canonPost.data.pubDate,
      path: `/blog/${canonPost.id}`,
    }
  : null;

const projections = canon ? projectionsFor(canon, ctx) : [];
const canonUrl = canon ? canonicalUrl(canon, ctx) : "";
const canonMarkdown = canon ? markdownUrl(canon, ctx) : "";

const MATCH_LABEL: Record<string, string> = {
  true: "coincide",
  false: "no coincide — gana el canon",
  null: "requiere nodo",
};
const matchLabel = (match: boolean | null) => MATCH_LABEL[String(match)];
---
<BaseLayout title="Un canon, cinco proyecciones — Portaless">
  <h1>Un canon, cinco proyecciones</h1>
  <p>
    El sitio tiene <strong>un</strong> estado canónico y todo lo que publica
    hacia afuera es una <strong>proyección</strong> derivada de él. Cuando una
    proyección y el canon no coinciden, gana el canon y la proyección se
    reconstruye. Esta página no lo afirma: lo deriva y lo compara.
  </p>

  {!canon && (
    <p class="empty-state">
      Todavía no hay ninguna publicación, así que no hay canon que proyectar.
    </p>
  )}

  {canon && (
    <>
      <section class="canon" aria-label="El canon">
        <p class="canon-kicker">El canon (fuente de verdad)</p>
        <h2>{canon.title}</h2>
        <p class="canon-source"><code>{canon.source}</code></p>
        <dl class="canon-meta">
          <dt>Página canónica</dt>
          <dd><a href={canonUrl}>{canonUrl}</a></dd>
          <dt>Fecha</dt>
          <dd><time datetime={canon.pubDate.toISOString()}>{canon.pubDate.toLocaleDateString("es-CL")}</time></dd>
        </dl>
      </section>

      <h2>Las cinco proyecciones</h2>
      <p class="proj-hint">
        Cada tarjeta muestra el valor <em>realmente derivado</em> de este canon
        y si coincide con él. <code>requiere nodo</code> significa que esa salida
        se firma o se publica en tiempo de request: en este demo estático no
        existe y por eso no se marcaría en verde.
      </p>

      <div class="proj-grid">
        {projections.map((projection) => (
          <article class={`proj proj-${projection.state}`}>
            <header class="proj-head">
              <h3>{projection.title}</h3>
              <span class="proj-channel">{projection.channel}</span>
            </header>
            <p class="proj-state" data-match={String(projection.match)}>
              {matchLabel(projection.match)}
            </p>
            <pre class="proj-value"><code>{projection.derived}</code></pre>
            <p class="proj-note">{projection.note}</p>
            <p class="proj-links">
              <a href={projection.href}>Ver la salida</a>
            </p>
          </article>
        ))}
      </div>

      <section class="canon-close">
        <h2>Por qué importa</h2>
        <p>
          Si Bluesky borra el espejo, si el feed se cae o si una plataforma
          sube el precio, el canon sigue intacto y cada proyección se
          reconstruye desde <code>{canon.source}</code>. La versión en texto del
          mismo artículo vive en <a href={canonMarkdown}>{canonMarkdown}</a>.
        </p>
      </section>
    </>
  )}
</BaseLayout>

<style>
  .canon {
    border: 1px solid var(--panel-border, #e4e6c3);
    border-left: 4px solid var(--accent, #c5d86d);
    border-radius: var(--radius-card, 16px);
    padding: var(--space-5, 24px);
    background: var(--panel-bg, #fff);
    margin: var(--space-5, 24px) 0;
  }
  .canon-kicker {
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--accent-text, #5a6b24);
  }
  .canon h2 { margin: var(--space-2, 8px) 0; }
  .canon-source { margin: 0 0 var(--space-3, 12px); color: var(--muted, #6e6653); }
  .canon-meta { display: grid; grid-template-columns: max-content 1fr; gap: var(--space-1, 4px) var(--space-3, 12px); margin: 0; }
  .canon-meta dt { font-weight: 600; }
  .canon-meta dd { margin: 0; overflow-wrap: anywhere; }

  .proj-hint { color: var(--muted, #6e6653); max-width: 70ch; }

  .proj-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-4, 16px);
    margin: var(--space-4, 16px) 0;
  }
  .proj {
    border: 1px solid var(--panel-border, #e4e6c3);
    border-radius: var(--radius-card, 16px);
    padding: var(--space-4, 16px);
    background: var(--panel-bg, #fff);
    display: flex;
    flex-direction: column;
  }
  .proj-node { border-style: dashed; }
  .proj-head { display: flex; align-items: baseline; justify-content: space-between; gap: var(--space-2, 8px); }
  .proj-head h3 { margin: 0; }
  .proj-channel { font-size: 0.75rem; color: var(--muted, #6e6653); text-align: right; }
  .proj-state { margin: var(--space-2, 8px) 0; font-weight: 700; font-size: 0.85rem; }
  .proj-state[data-match="true"] { color: var(--accent-text, #5a6b24); }
  .proj-state[data-match="false"] { color: var(--accent-2, #f05d23); }
  .proj-state[data-match="null"] { color: var(--muted, #6e6653); }
  .proj-value {
    margin: 0;
    padding: var(--space-3, 12px);
    background: var(--panel-border, #e4e6c3);
    border-radius: var(--radius-input, 8px);
    overflow-x: auto;
    font-size: 0.8rem;
    flex: 1;
  }
  .proj-value code { white-space: pre; }
  .proj-note { font-size: 0.85rem; color: var(--muted, #6e6653); }
  .proj-links { margin: 0; }

  .canon-close {
    border-top: 1px solid var(--panel-border, #e4e6c3);
    margin-top: var(--space-6, 32px);
    padding-top: var(--space-4, 16px);
  }
</style>
