---
// Flujo de recuperacion de contrasena en una sola pagina: paso 1 (pedir
// el enlace) y paso 2 (fijar la nueva contrasena) se distinguen por la
// presencia de ?token= en la URL, para no necesitar 2 rutas Astro
// distintas.
import BaseLayout from "../../layouts/BaseLayout.astro";

const token = Astro.url.searchParams.get("token");
---
<BaseLayout title="Recuperar contraseña — Portaless Admin">
  <div style="max-width: 360px; margin: 80px auto;">
    {!token ? (
      <>
        <h1 style="margin-bottom: 8px;">Recuperar contraseña</h1>
        <p style="color: var(--portaless-muted); margin-bottom: 24px;">
          Ingresa tu usuario y te enviaremos instrucciones si la cuenta existe.
        </p>
        <form id="request-form">
          <label style="display:block;margin-bottom:18px;">
            <span style="display:block;font-size:12px;color:var(--portaless-muted);margin-bottom:4px;">Usuario</span>
            <input name="username" type="text" required
              style="width:100%;padding:10px;border-radius:8px;border:1px solid var(--portaless-border);background:#12141a;color:#fff;" />
          </label>
          <button type="submit"
            style="width:100%;padding:10px;border-radius:999px;background:#6ee7b7;color:#0a0b0f;font-weight:700;border:none;cursor:pointer;">
            Enviar instrucciones
          </button>
        </form>
        <p id="request-result" style="margin-top:16px;font-size:13px;color:var(--portaless-muted);"></p>
      </>
    ) : (
      <>
        <h1 style="margin-bottom: 8px;">Elegir nueva contraseña</h1>
        <form id="confirm-form">
          <input type="hidden" name="token" value={token} />
          <label style="display:block;margin-bottom:18px;">
            <span style="display:block;font-size:12px;color:var(--portaless-muted);margin-bottom:4px;">Contraseña nueva</span>
            <input name="newPassword" type="password" minlength="8" required
              style="width:100%;padding:10px;border-radius:8px;border:1px solid var(--portaless-border);background:#12141a;color:#fff;" />
          </label>
          <button type="submit"
            style="width:100%;padding:10px;border-radius:999px;background:#6ee7b7;color:#0a0b0f;font-weight:700;border:none;cursor:pointer;">
            Guardar
          </button>
        </form>
        <p id="confirm-result" style="margin-top:16px;font-size:13px;color:var(--portaless-muted);"></p>
      </>
    )}
  </div>

  <script>
    const requestForm = document.getElementById("request-form");
    if (requestForm) {
      requestForm.addEventListener("submit", async (evt) => {
        evt.preventDefault();
        const username = evt.target.username.value;
        await fetch("/admin/password-reset/request", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ username }),
        });
        document.getElementById("request-result").textContent =
          "Si la cuenta existe, recibirás instrucciones en breve.";
      });
    }

    const confirmForm = document.getElementById("confirm-form");
    if (confirmForm) {
      confirmForm.addEventListener("submit", async (evt) => {
        evt.preventDefault();
        const token = evt.target.token.value;
        const newPassword = evt.target.newPassword.value;
        const res = await fetch("/admin/password-reset/confirm", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ token, newPassword }),
        });
        const body = await res.json();
        document.getElementById("confirm-result").textContent = body.success
          ? "Contraseña actualizada. Ya puedes iniciar sesión."
          : body.error || "No fue posible actualizar la contraseña.";
      });
    }
  </script>
</BaseLayout>
