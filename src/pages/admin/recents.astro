---
// Feed de actividad del sitio (Fase 10). Reemplaza honestamente a los
// paneles mock (traffic, ledger, orders, revenue) que mostraban datos
// falsos. Lee GET /admin/api/recents (sesion bajo /admin/*). Arranca vacio:
// no hay backfill, solo registra lo que pasa desde el deploy. Ver
// packages/dashboard/src/activity/activity-store.ts.
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Actividad — Portaless Admin">
  <header class="rc-header">
    <h1>Actividad</h1>
    <p>
      Lo que pasa en este sitio: páginas guardadas o borradas, atestaciones
      comunitarias recibidas y cambios de permisos. Es un registro
      <strong>solo para administradores</strong> — no guarda IPs ni datos
      sensibles y no se publica en ninguna superficie pública.
      Arranca vacío y solo registra lo que ocurre desde el deploy (no hay
      backfill).
    </p>
  </header>

  <section class="rc-card">
    <p class="rc-hint" id="rc-hint">Cargando…</p>
    <div class="rc-table-wrap">
      <table class="rc-table" id="rc-table" hidden>
        <thead>
          <tr><th>Cuándo</th><th>Tipo</th><th>Actor</th><th>Sujeto</th><th>Detalle</th></tr>
        </thead>
        <tbody></tbody>
      </table>
    </div>
  </section>
</BaseLayout>

<style is:global>
  .rc-header { margin-bottom: 20px; }
  .rc-header p { max-width: 70ch; color: var(--muted, #6E6653); }
  .rc-card { border: 1px solid var(--panel-border, #E4E6C3); border-radius: 12px; padding: 16px; background: var(--panel-bg, #fff); }
  .rc-hint { color: var(--muted, #6E6653); }
  .rc-hint.rc-error { color: #d3383f; }
  .rc-table-wrap { overflow-x: auto; }
  .rc-table { width: 100%; border-collapse: collapse; }
  .rc-table th, .rc-table td { text-align: left; padding: 8px 10px; border-bottom: 1px solid var(--panel-border, #E4E6C3); vertical-align: top; }
  .rc-table th { font-size: 0.85em; color: var(--muted, #6E6653); }
  .rc-table code { font-size: 0.9em; }
  .rc-badge { display: inline-block; padding: 1px 8px; border-radius: 999px; background: var(--bg, #F7F7F2); border: 1px solid var(--panel-border, #E4E6C3); font-size: 0.8em; }
</style>

<script>
  type ActivityEvent = {
    id: number;
    kind: string;
    actor: string | null;
    subject: string;
    detail: string | null;
    occurredAt: string;
  };

  // Etiqueta humana por kind. Un kind sin entrada se renderiza crudo
  // (fallback), y ESO es el defecto: el feed terminaba mostrando
  // "witness.recorded" o "plugin.installed" al operador. La lista cubre todos
  // los kind que emite emitActivity() en functions/.
  const KIND_LABELS: Record<string, string> = {
    "page.saved": "Página guardada",
    "page.approved": "Revisión aprobada y publicada",
    "page.deleted": "Página borrada",
    "community.attestation": "Atestación comunitaria",
    "permission.granted": "Permiso concedido",
    "permission.revoked": "Permiso revocado",
    "agents.policy_changed": "Política de acceso de agentes cambiada",
    "plugin.installed": "Plugin instalado",
    "plugin.uninstalled": "Plugin desinstalado",
    "witness.recorded": "Testigo registrado",
    "password.changed": "Contraseña cambiada",
    "password.reset": "Contraseña recuperada",
    "email.delivery.reconciliation_pending": "Correo: entrega pendiente de reconciliar",
  };

  const hint = document.getElementById("rc-hint")!;
  const table = document.getElementById("rc-table") as HTMLTableElement;

  function esc(s: string): string {
    return s.replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]!);
  }

  function fmtDate(iso: string): string {
    const d = new Date(iso);
    return Number.isNaN(d.valueOf()) ? esc(iso) : d.toLocaleString("es-CL");
  }

  async function load(): Promise<void> {
    const res = await fetch("/admin/api/recents");
    if (res.status === 401) { window.location.href = "/admin/login?error=1"; return; }
    if (!res.ok) { hint.classList.add("rc-error"); hint.textContent = `No se pudo cargar la actividad (HTTP ${res.status}).`; return; }
    const data = await res.json();
    const events: ActivityEvent[] = data.events ?? [];
    if (events.length === 0) {
      hint.textContent = "Todavía no hay actividad registrada.";
      return;
    }
    hint.textContent = `${events.length} evento(s), más reciente primero.`;
    const body = table.querySelector("tbody")!;
    body.innerHTML = events
      .map((e) => `<tr>
        <td>${fmtDate(e.occurredAt)}</td>
        <td><span class="rc-badge">${esc(KIND_LABELS[e.kind] ?? e.kind)}</span></td>
        <td>${e.actor ? `<code>${esc(e.actor)}</code>` : "—"}</td>
        <td><code>${esc(e.subject)}</code></td>
        <td>${e.detail ? esc(e.detail) : "—"}</td>
      </tr>`)
      .join("");
    table.hidden = false;
  }

  load();
</script>
