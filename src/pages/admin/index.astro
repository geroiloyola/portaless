---
// Indice del dashboard admin -- v0.0.9.18. Hasta ahora no existia ningun
// /admin/index.astro: cada pagina admin (permissions.astro, y desde el
// commit anterior, site-trust/[siteId]/self.astro) se accedia solo
// escribiendo la URL directamente, sin ningun punto de entrada comun.
// Esta pagina cierra ese hueco con la navegacion minima que YA tiene
// sentido hoy -- no inventa secciones que no existen (ej. "Sites",
// "Users") solo para parecer un dashboard completo.
//
// site-trust/[siteId]/self requiere un siteId concreto en la URL -- como
// todavia no existe un registro de "sitios conocidos" (equivalente al
// KNOWN_SUBJECTS de functions/admin/permissions/index.js para plugins),
// este indice linkea a un formulario que pide el siteId antes de navegar,
// en vez de asumir uno. Ver limitaciones en docs/architecture/
// site-trust-score.md.
//
// v0.0.9.25: agrega la tarjeta "Editor Visual", enlazando
// src/pages/admin/editor.astro (pagina nueva de este mismo commit).
// Reemplaza a public/editor/index.html como camino real de produccion --
// esa demo standalone sigue existiendo pero queda documentada como tal
// (elementRegistry duplicado y reducido, sin sesion, sin persistencia
// real), no como el editor que un admin autenticado deberia usar.
//
// v0.0.9.29: agrega el checklist diferido de onboarding (Fase 2, ver
// ROADMAP.md seccion "Onboarding de un click: Wizard + Checklist
// diferido"). Consulta GET /admin/api/apw-verification-status (nuevo) --
// que a su vez usa resolveApwManifest(), ya implementado en
// packages/apw-resolver desde hace varias sesiones. Deliberadamente NO
// bloqueante: si el DNS no propago todavia, o si el usuario nunca
// completa esto, el resto del panel funciona exactamente igual. Ver la
// entrada correspondiente en ROADMAP.md.
//
// v0.0.9.30: mientras el sitio no esta verificado, el banner muestra el
// registro TXT exacto (nombre + valor) con botones de copiar, tomado de
// `txtRecord` en la respuesta del endpoint. Ya no hace falta correr
// packages/apw-resolver/src/dnslink/cli.mjs a mano.
//
// v0.0.9.31 (APW v1.2): el banner muestra `identity` (desde PR #70) y
// `identity.h` (desde PR #71): DID, huella k, cabeza del historial y el
// resultado de la verificacion TXT + did.json con el motivo en lenguaje
// simple. Ademas detecta un TXT desactualizado -- publicado sin la k actual
// (manifiesto v1 viejo o clave rotada) o con un h anterior al del historial
// -- y muestra el valor nuevo para reemplazarlo. Antes un TXT v1 daba
// "Sitio Verificado" y nunca pedia actualizarse. Sin identidad, el banner
// se comporta igual que antes.
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  capabilityRegistry,
  listCapabilitiesByRisk,
  RISK_LABELS,
  RISK_ORDER,
} from "../../../packages/plugin-sandbox/src/capabilities/capability-registry";

// §13.5: el dashboard muestra el riesgo de las capacidades concedidas, no solo
// un enlace al Centro de Permisos. El total por nivel sale del catalogo (build);
// las concedidas se cuentan en el navegador contra /admin/permissions, porque
// el build estatico no conoce los grants. Sin nodo con functions, degrada.
const capsByRisk = listCapabilitiesByRisk();
const riskById = Object.fromEntries(
  Object.values(capabilityRegistry).map((cap) => [cap.id, cap.risk])
);
const riskIdMapJson = JSON.stringify(riskById);
---
<BaseLayout title="Panel de administración — Portaless">
  <div class="ai-page-header">
    <h1 class="ai-page-title">Panel de administración</h1>
    <p class="ai-page-subtitle">Accesos directos a las herramientas de administración del sitio.</p>
  </div>

  <section class="ai-apw-checklist" id="ai-apw-checklist">
    <div class="ai-apw-checklist-row">
      <div class="ai-apw-checklist-text">
        <span class="ai-apw-checklist-title">Reclamar tu identidad verificada (Protocol APW)</span>
        <p class="ai-apw-checklist-desc" id="ai-apw-desc">Comprobando si tu dominio ya tiene publicado el registro TXT de Protocol APW…</p>
      </div>
      <div class="ai-apw-checklist-actions">
        <span class="ai-apw-badge" id="ai-apw-badge" hidden>✓ Sitio Verificado</span>
        <span class="ai-apw-badge" id="ai-apw-identity-badge" hidden>✓ Identidad verificada</span>
        <button type="button" class="ai-apw-verify-btn" id="ai-apw-verify-btn">Verificar ahora</button>
      </div>
    </div>

    <div class="ai-apw-identity" id="ai-apw-identity" hidden>
      <p class="ai-apw-identity-status" id="ai-apw-identity-status"></p>
      <p class="ai-apw-txt-hint" id="ai-apw-anchor-status" hidden></p>
      <div class="ai-apw-txt-field">
        <span class="ai-apw-txt-label">Identidad (DID)</span>
        <code class="ai-apw-txt-code" id="ai-apw-identity-did"></code>
        <button type="button" class="ai-apw-copy-btn" data-copy-target="ai-apw-identity-did">Copiar</button>
      </div>
      <div class="ai-apw-txt-field">
        <span class="ai-apw-txt-label">Huella de la clave (k)</span>
        <code class="ai-apw-txt-code" id="ai-apw-identity-k"></code>
        <button type="button" class="ai-apw-copy-btn" data-copy-target="ai-apw-identity-k">Copiar</button>
      </div>
      <div class="ai-apw-txt-field" id="ai-apw-identity-h-row" hidden>
        <span class="ai-apw-txt-label">Historial (h)</span>
        <code class="ai-apw-txt-code" id="ai-apw-identity-h"></code>
        <button type="button" class="ai-apw-copy-btn" data-copy-target="ai-apw-identity-h">Copiar</button>
      </div>
      <p class="ai-apw-txt-hint">
        Estos datos son públicos. Cualquier agente puede comprobarlos en tu registro TXT y en <code>/.well-known/did.json</code>.
      </p>
    </div>

    <div class="ai-apw-txt" id="ai-apw-txt" hidden>
      <p class="ai-apw-txt-warn" id="ai-apw-txt-stale" hidden></p>
      <p class="ai-apw-txt-intro">
        Entrá al panel de tu proveedor de dominio (donde compraste el dominio o donde administrás el DNS), creá un registro nuevo con estos datos y guardá:
      </p>
      <div class="ai-apw-txt-field">
        <span class="ai-apw-txt-label">Tipo</span>
        <code class="ai-apw-txt-code">TXT</code>
      </div>
      <div class="ai-apw-txt-field">
        <span class="ai-apw-txt-label">Nombre / Host</span>
        <code class="ai-apw-txt-code" id="ai-apw-txt-name"></code>
        <button type="button" class="ai-apw-copy-btn" data-copy-target="ai-apw-txt-name">Copiar</button>
      </div>
      <div class="ai-apw-txt-field">
        <span class="ai-apw-txt-label">Valor / Contenido</span>
        <code class="ai-apw-txt-code ai-apw-txt-value" id="ai-apw-txt-value"></code>
        <button type="button" class="ai-apw-copy-btn" data-copy-target="ai-apw-txt-value">Copiar</button>
      </div>
      <p class="ai-apw-txt-hint">
        Algunos proveedores completan el dominio solos: si tu panel ya muestra “<span id="ai-apw-txt-domain"></span>” al lado del campo Nombre, escribí solo <code>_apw</code>.
        Después volvé acá y tocá “Verificar ahora”.
      </p>
      <p class="ai-apw-txt-warn" id="ai-apw-txt-warn" hidden></p>
    </div>
  </section>

  <section class="ai-risk-summary" id="ai-risk-summary" aria-label="Resumen de riesgo de permisos">
    <div class="ai-risk-summary-row">
      <div class="ai-risk-summary-text">
        <span class="ai-risk-summary-title">Riesgo de permisos</span>
        <p class="ai-risk-summary-desc" id="ai-risk-desc">Contando cuántas capacidades están concedidas…</p>
      </div>
      <a class="ai-risk-summary-link" href="/admin/permissions">Abrir el Centro de Permisos</a>
    </div>
    <div class="ai-risk-summary-grid">
      {RISK_ORDER.map((risk) => (
        <div class="ai-risk-cell" data-risk={risk}>
          <span class="ai-risk-count" id={`ai-risk-${risk}`} data-total={capsByRisk[risk].length}>—</span>
          <span class="ai-risk-label">{RISK_LABELS[risk]} · de {capsByRisk[risk].length}</span>
        </div>
      ))}
    </div>
    <script type="application/json" id="ai-risk-map" set:html={riskIdMapJson} />
  </section>

  <nav class="ai-nav-grid">
    <a class="ai-nav-card" href="/admin/editor">
      <span class="ai-nav-card-title">Editor Visual</span>
      <span class="ai-nav-card-desc">Arma páginas con Atomic Elements: arrastra elementos, edita propiedades, guarda directo en la base de datos del sitio.</span>
    </a>

    <a class="ai-nav-card" href="/admin/appearance">
      <span class="ai-nav-card-title">Apariencia</span>
      <span class="ai-nav-card-desc">Elegí el skin activo y la paleta del sitio: el cambio se refleja en el panel, el editor y la página publicada desde un solo lugar.</span>
    </a>

    <a class="ai-nav-card" href="/admin/analytics">
      <span class="ai-nav-card-title">Analytics</span>
      <span class="ai-nav-card-desc">Configurá Plausible, Cloudflare, umami o un script propio: el sitio lo sirve desde /api/analytics y solo se guarda proveedor, id y origen https.</span>
    </a>

    <a class="ai-nav-card" href="/admin/settings/email">
      <span class="ai-nav-card-title">Email</span>
      <span class="ai-nav-card-desc">Proveedor transaccional (webhook o SMTP), remitente del sitio y plantillas aprobadas. Los plugins solo pueden pedir plantillas aprobadas; el remitente lo pone el sitio.</span>
    </a>

    <a class="ai-nav-card" href="/admin/pages">
      <span class="ai-nav-card-title">Páginas</span>
      <span class="ai-nav-card-desc">Listá, editá y borrá las páginas publicadas con Atomic Elements. Editar y publicar actualiza la página al instante en self-host.</span>
    </a>

    <a class="ai-nav-card" href="/admin/witness-index">
      <span class="ai-nav-card-title">Portaless Index</span>
      <span class="ai-nav-card-desc">Agregador de testigos (APW §5.7): sincronizá sujetos contra testigos y pares nodo-indice; pesos calibrados automáticamente.</span>
    </a>

    <a class="ai-nav-card" href="/admin/recents">
      <span class="ai-nav-card-title">Actividad</span>
      <span class="ai-nav-card-desc">Lo que pasó en el sitio: páginas guardadas o borradas, atestaciones comunitarias recibidas y cambios de permisos. Solo administradores.</span>
    </a>

    <a class="ai-nav-card" href="/admin/permissions">
      <span class="ai-nav-card-title">Centro de Permisos</span>
      <span class="ai-nav-card-desc">Conceder o revocar capacidades a plugins y agentes instalados.</span>
    </a>

    <a class="ai-nav-card" href="/admin/agents">
      <span class="ai-nav-card-title">Acceso de agentes</span>
      <span class="ai-nav-card-desc">Quién puede leer este sitio, en español claro y con el valor efectivo a la vista: permití, cobrá o bloqueá por regla y sabé de dónde sale.</span>
    </a>

    <a class="ai-nav-card" href="/admin/authorized-agents">
      <span class="ai-nav-card-title">Agentes autorizados (SiteTrustScore)</span>
      <span class="ai-nav-card-desc">Allowlist de agentes de IA con permiso para reportar sobre la fuente "agent" del Site Trust Score.</span>
    </a>

    <a class="ai-nav-card" href="/admin/authorized-escrow-providers">
      <span class="ai-nav-card-title">Proveedores de escrow (SiteTrustScore)</span>
      <span class="ai-nav-card-desc">Allowlist de proveedores autorizados a reportar resultados reales de transaccion (fuente "escrow_report").</span>
    </a>

    <a class="ai-nav-card" href="/admin/trust-svri">
      <span class="ai-nav-card-title">SVRI — evidencia y proyección</span>
      <span class="ai-nav-card-desc">Consulta la puntuación interna, sus cinco tiers, el peso del prior matemático y la reconstrucción histórica HSVR. Solo administradores.</span>
    </a>

    <div class="ai-nav-card ai-nav-card-form">
      <span class="ai-nav-card-title">Site Trust Score — autoevaluación</span>
      <span class="ai-nav-card-desc">
        Declará el cumplimiento de tu propio sitio (GDPR, política de privacidad, seguridad de pago, etc.).
      </span>
      <form id="ai-site-trust-form" class="ai-site-trust-form">
        <input
          type="text"
          id="ai-site-id-input"
          class="ai-site-id-input"
          placeholder="tu-dominio.com"
          autocomplete="off"
          required
        />
        <button type="submit" class="ai-site-id-submit">Ir</button>
      </form>
    </div>
  </nav>
</BaseLayout>

<script>
  const form = document.getElementById("ai-site-trust-form");
  const input = document.getElementById("ai-site-id-input");

  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    const siteId = input.value.trim();
    if (!siteId) return;
    window.location.href = `/admin/site-trust/${encodeURIComponent(siteId)}/self`;
  });
</script>

<script>
  // Checklist diferido de Protocol APW -- ver comentario de cabecera del
  // archivo. Nunca bloquea: si falla la consulta o el DNS no propago,
  // el resto del dashboard sigue funcionando igual.
  const apwDesc = document.getElementById("ai-apw-desc");
  const apwBadge = document.getElementById("ai-apw-badge");
  const apwIdentityBadge = document.getElementById("ai-apw-identity-badge");
  const apwBtn = document.getElementById("ai-apw-verify-btn");
  const apwTxt = document.getElementById("ai-apw-txt");
  const apwTxtName = document.getElementById("ai-apw-txt-name");
  const apwTxtValue = document.getElementById("ai-apw-txt-value");
  const apwTxtDomain = document.getElementById("ai-apw-txt-domain");
  const apwTxtWarn = document.getElementById("ai-apw-txt-warn");
  const apwTxtStale = document.getElementById("ai-apw-txt-stale");
  const apwIdentity = document.getElementById("ai-apw-identity");
  const apwIdentityStatus = document.getElementById("ai-apw-identity-status");
  const apwIdentityDid = document.getElementById("ai-apw-identity-did");
  const apwIdentityK = document.getElementById("ai-apw-identity-k");
  const apwIdentityHRow = document.getElementById("ai-apw-identity-h-row");
  const apwIdentityH = document.getElementById("ai-apw-identity-h");
  const apwAnchorStatus = document.getElementById("ai-apw-anchor-status");

  const REASON_LABELS = {
    no_valid_manifest_found: "Todavía no encontramos un manifiesto APW válido en tu DNS.",
  };

  // Motivos de resolveApwIdentity() (packages/apw-resolver/src/index.ts).
  const IDENTITY_REASON_LABELS = {
    no_txt_records: "Todavía no hay ningún registro TXT _apw publicado.",
    no_valid_manifest_found: "El registro TXT publicado no es un manifiesto APW válido.",
    manifest_without_key: "El registro TXT publicado no incluye la huella de tu clave (k). Reemplazalo por el valor de abajo.",
    did_document_unreachable: "No pudimos leer /.well-known/did.json en tu dominio.",
    invalid_did_document: "El documento /.well-known/did.json de tu dominio no es válido.",
    did_mismatch: "El documento /.well-known/did.json pertenece a otro dominio.",
    key_mismatch: "La clave publicada en el TXT no coincide con la de tu sitio. Si rotaste la clave, reemplazá el TXT por el valor de abajo.",
  };

  function renderTxtRecord(txtRecord, domain, staleMessage) {
    if (!txtRecord) {
      apwTxt.hidden = true;
      return;
    }
    apwTxtName.textContent = txtRecord.name;
    apwTxtValue.textContent = txtRecord.value;
    apwTxtDomain.textContent = domain;
    if (txtRecord.withinLimit === false) {
      apwTxtWarn.textContent = `Atención: el valor ocupa ${txtRecord.bytes} bytes, más que el límite práctico de 512 de un registro DNS. Algunos proveedores podrían rechazarlo.`;
      apwTxtWarn.hidden = false;
    } else {
      apwTxtWarn.hidden = true;
    }
    if (staleMessage) {
      apwTxtStale.textContent = staleMessage;
      apwTxtStale.hidden = false;
    } else {
      apwTxtStale.hidden = true;
    }
    apwTxt.hidden = false;
  }

  // El TXT publicado esta desactualizado si no tiene la k actual del sitio
  // (manifiesto v1 viejo o clave rotada) o si su h no es la cabeza actual
  // del historial encadenado.
  function staleTxtMessage(data) {
    const identity = data.identity;
    if (!identity || !data.manifest) return null;
    if (data.manifest.k !== identity.k) {
      return "Tu registro TXT está desactualizado: no incluye la huella de tu clave actual. Reemplazá el valor por el de abajo (no hace falta crear un registro nuevo).";
    }
    if (identity.h && data.manifest.h !== identity.h) {
      return "Tu historial tiene entradas nuevas que todavía no están ancladas en el DNS. Reemplazá el valor del TXT por el de abajo para anclarlas.";
    }
    return null;
  }

  function renderIdentity(identity) {
    if (!identity) {
      apwIdentity.hidden = true;
      apwIdentityBadge.hidden = true;
      return;
    }
    apwIdentityDid.textContent = identity.did;
    apwIdentityK.textContent = identity.k;
    if (identity.h) {
      apwIdentityH.textContent = identity.h;
      apwIdentityHRow.hidden = false;
    } else {
      apwIdentityHRow.hidden = true;
    }
    if (identity.verified) {
      apwIdentityStatus.textContent = "Identidad verificada: tu registro TXT y /.well-known/did.json publican la misma clave.";
      apwIdentityBadge.hidden = false;
    } else {
      const label = IDENTITY_REASON_LABELS[identity.reason] || `Motivo: ${identity.reason}.`;
      apwIdentityStatus.textContent = `Identidad todavía no verificada. ${label}`;
      apwIdentityBadge.hidden = true;
    }
    apwIdentity.hidden = false;
  }

  // E-10: estado del anclaje de `h` en el DNS. Solo informativo -- para
  // anclar se pega el TXT sugerido (o corre dnslink/cli.mjs --anchor); los
  // testigos anclan sin tocar el DNS.
  function renderAnchor(anchor) {
    if (!anchor || anchor.status === "no_identity" || anchor.status === "no_history") {
      apwAnchorStatus.hidden = true;
      return;
    }
    const messages = {
      no_txt: "Todavía no hay registro TXT _apw publicado: tu historial no está anclado en el DNS.",
      txt_without_h: "Tu registro TXT existe pero no incluye `h`: el historial completo quedó sin anclar.",
      up_to_date: `Anclaje al día: el \`h\` publicado en el DNS corresponde a la entrada ${anchor.localSeq} del historial.`,
      stale: `Entradas nuevas sin anclar en el DNS: el TXT publica un \`h\` viejo (local actual: entrada ${anchor.localSeq}). Reemplazá el valor por el de abajo o corrí "dnslink/cli.mjs --anchor".`,
    };
    apwAnchorStatus.textContent = messages[anchor.status] ?? "";
    apwAnchorStatus.hidden = !messages[anchor.status];
  }

  async function checkApwStatus() {
    apwBtn.disabled = true;
    apwBtn.textContent = "Verificando…";
    try {
      const res = await fetch("/admin/api/apw-verification-status", { credentials: "same-origin" });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const data = await res.json();
      renderIdentity(data.identity);
      renderAnchor(data.anchor);
      if (data.verified) {
        const stale = staleTxtMessage(data);
        apwBadge.hidden = false;
        apwDesc.textContent = `Dominio verificado (${data.domain}). Tu identidad APW ya es públicamente resoluble.`;
        if (stale) {
          apwBtn.hidden = false;
          renderTxtRecord(data.txtRecord, data.domain, stale);
        } else {
          apwBtn.hidden = true;
          apwTxt.hidden = true;
        }
      } else {
        apwBadge.hidden = true;
        apwBtn.hidden = false;
        const reasonLabel = REASON_LABELS[data.reason] || `Motivo: ${data.reason}.`;
        apwDesc.textContent = `Registro TXT de Protocol APW no encontrado todavía en ${data.domain}. ${reasonLabel} Si ya lo agregaste, la propagación de DNS puede tardar minutos u horas. Podés seguir usando el panel con normalidad mientras tanto.`;
        renderTxtRecord(data.txtRecord, data.domain, null);
      }
    } catch (e) {
      apwDesc.textContent = `No pudimos comprobar el estado de la verificación (${e.message}). Podés reintentar cuando quieras -- el resto del panel funciona igual.`;
    } finally {
      apwBtn.disabled = false;
      apwBtn.textContent = "Verificar ahora";
    }
  }

  document.querySelectorAll(".ai-apw-copy-btn").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const target = document.getElementById(btn.dataset.copyTarget);
      if (!target) return;
      try {
        await navigator.clipboard.writeText(target.textContent || "");
        btn.textContent = "Copiado ✓";
      } catch {
        const range = document.createRange();
        range.selectNodeContents(target);
        const sel = window.getSelection();
        sel?.removeAllRanges();
        sel?.addRange(range);
        btn.textContent = "Seleccionado: Ctrl+C";
      }
      setTimeout(() => { btn.textContent = "Copiar"; }, 2000);
    });
  });

  apwBtn?.addEventListener("click", checkApwStatus);
  checkApwStatus();
</script>

<script>
  // §13.5: resumen de riesgo. El total por nivel ya viene del build (catalogo);
  // aca se cuentan las capacidades CONCEDIDAS (al menos un grant activo), que
  // solo se conocen en runtime. Si el hosting no tiene functions, el fetch
  // falla y se dice, en vez de mostrar un cero falso.
  const riskMapEl = document.getElementById("ai-risk-map");
  const RISK_BY_ID = riskMapEl ? JSON.parse(riskMapEl.textContent || "{}") : {};
  const RISK_LEVELS = ["alto", "medio", "bajo"];

  async function loadRiskSummary() {
    const desc = document.getElementById("ai-risk-desc");
    try {
      const res = await fetch("/admin/permissions", {
        credentials: "same-origin",
        headers: { accept: "application/json" },
      });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const data = await res.json();
      const granted = new Set();
      for (const grant of data.grants || []) if (grant.granted) granted.add(grant.capabilityId);

      const counts = { alto: 0, medio: 0, bajo: 0 };
      for (const id of granted) {
        const risk = RISK_BY_ID[id];
        if (risk) counts[risk] += 1;
      }
      for (const risk of RISK_LEVELS) {
        const el = document.getElementById(`ai-risk-${risk}`);
        if (el) el.textContent = String(counts[risk]);
      }
      desc.textContent =
        counts.alto > 0
          ? `Hay ${counts.alto} ${counts.alto === 1 ? "capacidad" : "capacidades"} de alto riesgo concedidas. Revisá el Centro de Permisos.`
          : "Ninguna capacidad de alto riesgo está concedida.";
    } catch (e) {
      desc.textContent = "No pudimos leer los permisos concedidos en este hosting (requiere un nodo con functions). El total por nivel del catálogo se muestra igual.";
      for (const risk of RISK_LEVELS) {
        const el = document.getElementById(`ai-risk-${risk}`);
        if (el) el.textContent = "—";
      }
    }
  }

  loadRiskSummary();
</script>

<style>
  .ai-page-header { margin-bottom: 28px; }
  .ai-page-title { margin: 0 0 6px; font-size: 1.4rem; }
  .ai-page-subtitle { margin: 0; color: var(--portaless-muted); font-size: 0.9rem; }

