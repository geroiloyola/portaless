---
// UI de administracion para la allowlist de agentes autorizados a
// reportar sobre la fuente "agent" de SiteTrustScore. Requiere sesion
// valida -- protegido por functions/admin/_middleware.js.
//
// Antes de esta pagina, la UNICA forma de dar de alta un agente era
// scripts/onboard-agent.mjs (CLI, self-hosted only, sin cobertura D1) --
// ver ROADMAP.md. Los datos vienen de functions/admin/api/
// authorized-agents.js (GET/POST/PATCH), que a su vez usa
// createAuthorizedAgentsStore(env) (D1/SQLite reales).
//
// Mismo patron que src/pages/admin/permissions.astro: fetch client-side
// desde el <script>, estados de carga/error como <div> conmutados por
// display, redirect a /admin/login?error=1 en 401.
import BaseLayout from "../../layouts/BaseLayout.astro";
---
<BaseLayout title="Agentes autorizados — Portaless Admin">
  <div class="aa-page-header">
    <h1 class="aa-page-title">Agentes autorizados (SiteTrustScore)</h1>
    <p class="aa-page-subtitle">
      Allowlist de agentes de IA con permiso para reportar verificaciones
      sobre la fuente "agent" del Site Trust Score. Identidad verificada
      (Web Bot Auth) no es lo mismo que autorizacion -- un agente puede
      probar quien es sin tener permiso para reportar aqui.
    </p>
  </div>

  <div id="aa-loading" class="aa-loading">Cargando agentes autorizados…</div>
  <div id="aa-load-error" class="aa-load-error" style="display:none;"></div>

  <div id="aa-root" style="display:none;">
    <form id="aa-grant-form" class="aa-form">
      <h2 class="aa-form-title">Dar de alta un agente</h2>
      <label class="aa-field">
        <span>Agent Key ID</span>
        <input type="text" id="aa-input-key" placeholder="agent.example.com" required autocomplete="off" />
      </label>
      <label class="aa-field">
        <span>Signature Agent URL</span>
        <input type="url" id="aa-input-url" placeholder="https://agent.example.com/.well-known/http-message-signatures-directory" required autocomplete="off" />
      </label>
      <label class="aa-field">
        <span>Nombre visible</span>
        <input type="text" id="aa-input-name" placeholder="Nombre del agente o proveedor" required autocomplete="off" />
      </label>
      <button type="submit" class="aa-submit">Autorizar agente</button>
      <p id="aa-form-error" class="aa-form-error" style="display:none;"></p>
    </form>

    <table class="aa-table">
      <thead>
        <tr>
          <th>Agent Key ID</th>
          <th>Nombre</th>
          <th>Estado</th>
          <th>Autorizado</th>
          <th></th>
        </tr>
      </thead>
      <tbody id="aa-table-body"></tbody>
    </table>
  </div>
</BaseLayout>

<script>
  interface AuthorizedAgent {
    agentKeyId: string;
    signatureAgentUrl: string;
    displayName: string;
    active: boolean;
    authorizedAt: string;
    authorizedBy: string;
    keyAlgorithm: string;
  }

  const loadingEl = document.getElementById("aa-loading")!;
  const errorEl = document.getElementById("aa-load-error")!;
  const rootEl = document.getElementById("aa-root")!;
  const tableBody = document.getElementById("aa-table-body")!;
  const form = document.getElementById("aa-grant-form") as HTMLFormElement;
  const formError = document.getElementById("aa-form-error")!;

  async function parseErrorMessage(res: Response): Promise<string> {
    let message = `HTTP ${res.status}`;
    try {
      const body = await res.json();
      if (body?.message) message = body.message;
      else if (body?.error) message = body.error;
    } catch {
      // Respuesta sin body JSON -- se usa el mensaje generico de arriba.
    }
    return message;
  }

  function renderTable(agents: AuthorizedAgent[]): void {
    tableBody.innerHTML = "";

    if (agents.length === 0) {
      const row = document.createElement("tr");
      row.innerHTML = `<td colspan="5" class="aa-empty-row">Sin agentes autorizados todavia.</td>`;
      tableBody.appendChild(row);
      return;
    }

    for (const agent of agents) {
      const row = document.createElement("tr");
      const statusLabel = agent.active ? "Activo" : "Revocado";
      const statusClass = agent.active ? "aa-status-active" : "aa-status-revoked";
      const authorizedDate = new Date(agent.authorizedAt).toLocaleString();

      row.innerHTML = `
        <td>${escapeHtml(agent.agentKeyId)}</td>
        <td>${escapeHtml(agent.displayName)}</td>
        <td><span class="${statusClass}">${statusLabel}</span></td>
        <td>${escapeHtml(authorizedDate)}</td>
        <td></td>
      `;

      if (agent.active) {
        const revokeBtn = document.createElement("button");
        revokeBtn.textContent = "Revocar";
        revokeBtn.className = "aa-revoke-btn";
        revokeBtn.addEventListener("click", () => revokeAgent(agent.agentKeyId));
        row.lastElementChild!.appendChild(revokeBtn);
      }

      tableBody.appendChild(row);
    }
  }

  function escapeHtml(value: string): string {
    const div = document.createElement("div");
    div.textContent = value;
    return div.innerHTML;
  }

  async function loadAgents(): Promise<void> {
    const res = await fetch("/admin/api/authorized-agents");

    if (res.status === 401) {
      window.location.href = "/admin/login?error=1";
      return;
    }

    if (!res.ok) {
      throw new Error(await parseErrorMessage(res));
    }

    const data = await res.json();
    renderTable(data.agents ?? []);
  }

  async function revokeAgent(agentKeyId: string): Promise<void> {
    if (!confirm(`¿Revocar el agente "${agentKeyId}"? Esto no borra su historial, solo desactiva su autorizacion.`)) {
      return;
    }

    try {
      const res = await fetch("/admin/api/authorized-agents", {
        method: "PATCH",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ agentKeyId }),
      });

      if (res.status === 401) {
        window.location.href = "/admin/login?error=1";
        return;
      }
      if (!res.ok) {
        throw new Error(await parseErrorMessage(res));
      }

      await loadAgents();
    } catch (err) {
      alert(`Error al revocar: ${(err as Error).message}`);
    }
  }

  form.addEventListener("submit", async (event) => {
    event.preventDefault();
    formError.style.display = "none";

    const agentKeyId = (document.getElementById("aa-input-key") as HTMLInputElement).value.trim();
    const signatureAgentUrl = (document.getElementById("aa-input-url") as HTMLInputElement).value.trim();
    const displayName = (document.getElementById("aa-input-name") as HTMLInputElement).value.trim();

    if (!agentKeyId || !signatureAgentUrl || !displayName) return;

    try {
      const res = await fetch("/admin/api/authorized-agents", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ agentKeyId, signatureAgentUrl, displayName }),
      });

      if (res.status === 401) {
        window.location.href = "/admin/login?error=1";
        return;
      }
      if (!res.ok) {
        throw new Error(await parseErrorMessage(res));
      }

      form.reset();
      await loadAgents();
    } catch (err) {
      formError.style.display = "";
      formError.textContent = (err as Error).message;
    }
  });

  async function init(): Promise<void> {
    try {
      await loadAgents();
      loadingEl.style.display = "none";
      rootEl.style.display = "";
    } catch (err) {
      loadingEl.style.display = "none";
      errorEl.style.display = "";
      errorEl.textContent = `Error al cargar agentes autorizados: ${(err as Error).message}`;
    }
  }

  init();
</script>

<style>
  .aa-page-header { margin-bottom: 28px; }
  .aa-page-title { margin: 0 0 6px; font-size: 1.4rem; }
  .aa-page-subtitle { margin: 0; color: var(--portaless-muted); font-size: 0.9rem; max-width: 640px; line-height: 1.5; }

  .aa-loading, .aa-load-error { font-size: 0.9rem; color: var(--portaless-muted); }
  .aa-load-error { color: #ff6e6e; }

  .aa-form {
    max-width: 480px;
    margin-bottom: 32px;
    padding: 20px;
    border: 1px solid var(--portaless-border);
    border-radius: 12px;
    background: #14161b;
  }
  .aa-form-title { margin: 0 0 16px; font-size: 1rem; }
  .aa-field { display: block; margin-bottom: 14px; }
  .aa-field span { display: block; font-size: 0.8rem; color: var(--portaless-muted); margin-bottom: 5px; }
  .aa-field input {
    width: 100%;
    background: #0f1114;
    border: 1px solid var(--portaless-border);
    border-radius: 6px;
    color: var(--portaless-fg);
    padding: 8px 10px;
    font-size: 0.85rem;
  }
  .aa-submit {
    border: 1px solid var(--portaless-accent);
    background: var(--portaless-accent);
    color: #0f1114;
    border-radius: 6px;
    padding: 8px 18px;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
  }
  .aa-form-error { color: #ff6e6e; font-size: 0.8rem; margin-top: 10px; }

  .aa-table { width: 100%; border-collapse: collapse; font-size: 0.85rem; }
  .aa-table th, .aa-table td { text-align: left; padding: 10px 12px; border-bottom: 1px solid var(--portaless-border); }
  .aa-table th { color: var(--portaless-muted); font-weight: 600; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.04em; }
  .aa-empty-row { text-align: center; color: var(--portaless-muted); padding: 24px; }

  .aa-status-active { color: #6ee7b7; }
  .aa-status-revoked { color: var(--portaless-muted); }

  .aa-revoke-btn {
    border: 1px solid #ff6e6e;
    background: transparent;
    color: #ff6e6e;
    border-radius: 6px;
    padding: 4px 12px;
    font-size: 0.78rem;
    cursor: pointer;
  }
  .aa-revoke-btn:hover { background: #ff6e6e; color: #0f1114; }
</style>
