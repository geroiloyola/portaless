---
// Pagina de login del panel de administracion. Fuera del sandbox de
// contenido de Portaless -- esta ruta nunca se sirve como contenido
// publico, solo como puerta de entrada al dashboard.
import BaseLayout from "../../layouts/BaseLayout.astro";

const error = Astro.url.searchParams.get("error");
---
<BaseLayout title="Iniciar sesión — Portaless Admin">
  <div style="max-width: 360px; margin: 80px auto;">
    <h1 style="margin-bottom: 8px;">Portaless Admin</h1>
    <p style="color: var(--portaless-muted); margin-bottom: 24px;">
      Autenticación mínima (usuario/contraseña). Sin OAuth en esta versión.
    </p>

    {error && (
      <p style="background:#331313;color:#ff8f8f;padding:10px 14px;border-radius:8px;margin-bottom:16px;font-size:13px;">
        Usuario o contraseña incorrectos.
      </p>
    )}

    <form method="POST" action="/admin/login">
      <label style="display:block;margin-bottom:14px;">
        <span style="display:block;font-size:12px;color:var(--portaless-muted);margin-bottom:4px;">Usuario</span>
        <input name="username" type="text" required
          style="width:100%;padding:10px;border-radius:8px;border:1px solid var(--portaless-border);background:#12141a;color:#fff;" />
      </label>
      <label style="display:block;margin-bottom:18px;">
        <span style="display:block;font-size:12px;color:var(--portaless-muted);margin-bottom:4px;">Contraseña</span>
        <input name="password" type="password" required
          style="width:100%;padding:10px;border-radius:8px;border:1px solid var(--portaless-border);background:#12141a;color:#fff;" />
      </label>
      <button type="submit"
        style="width:100%;padding:10px;border-radius:999px;background:#6ee7b7;color:#0a0b0f;font-weight:700;border:none;cursor:pointer;">
        Entrar
      </button>
    </form>
  </div>
</BaseLayout>
