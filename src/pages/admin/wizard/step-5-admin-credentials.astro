---
// src/pages/admin/wizard/step-5-admin-credentials.astro
//
// Paso 5 (ultimo) del Wizard de onboarding: credenciales de admin.
//
// HALLAZGO CRITICO de esta sesion, confirmado por el README y el propio
// ROADMAP: Portaless NO tiene hoy un endpoint HTTP que cree el primer
// usuario admin. El unico mecanismo real es `npm run setup`
// (scripts/setup.mjs, CLI, requiere PORTALESS_ADMIN_USERNAME/PASSWORD
// como variables de entorno) para SQLite self-hosted, o la creacion
// automatica del primer admin en Cloudflare D1 la primera vez que el
// sistema detecta que no existe ninguno.
//
// Inventar aqui un endpoint POST /admin/api/create-admin que registre
// un usuario nuevo seria (a) duplicar un mecanismo de arranque que ya
// existe y (b) un riesgo de seguridad real: un endpoint publico que crea
// usuarios admin sin proteccion es una puerta de escalada de privilegios.
// Por eso este paso NO implementa un formulario de registro -- detecta
// el estado real via GET /admin/api/wizard/admin-status y guia al
// usuario segun corresponda.
import BaseLayout from "../../../layouts/BaseLayout.astro";
---
<BaseLayout title="Último paso: tu cuenta de administrador — Portaless Wizard">
  <div class="wiz-page-header">
    <p class="wiz-step-indicator">Paso 5 de 5</p>
    <h1 class="wiz-page-title">Tu cuenta de administrador</h1>
    <p class="wiz-page-subtitle">
      Último paso antes de entrar al panel.
    </p>
  </div>

  <div id="wiz-loading" class="wiz-loading">Verificando tu instalación…</div>
  <div id="wiz-load-error" class="wiz-load-error" style="display:none;"></div>

  <div id="wiz-case-a" class="wiz-case-panel" style="display:none;">
    <p class="wiz-case-text">
      Tu cuenta de administrador ya existe. Inicia sesión para entrar al panel.
    </p>
    <a href="/admin/login" class="wiz-login-btn">Iniciar sesión →</a>
  </div>

  <div id="wiz-case-b" class="wiz-case-panel" style="display:none;">
    <p class="wiz-case-text">
      Tu instalación usa SQLite local. Por seguridad, la primera cuenta de
      administrador se crea desde la terminal, no desde el navegador.
      Corre este comando una sola vez:
    </p>
    <div class="wiz-command-box">
      <code id="wiz-command-value" class="wiz-command-value"></code>
      <button id="wiz-command-copy" class="wiz-command-copy" type="button">Copiar</button>
    </div>
    <p class="wiz-case-hint">
      Reemplaza la contraseña por una real antes de correr el comando.
      Cuando termine, recarga esta página.
    </p>
    <button id="wiz-recheck-btn" class="wiz-recheck-btn" type="button">Ya lo corrí, verificar de nuevo</button>
  </div>
</BaseLayout>

<script>
  interface AdminStatusResponse {
    adminExists: boolean;
    backend: "d1" | "sqlite" | "memory";
  }

  const loadingEl = document.getElementById("wiz-loading")!;
  const errorEl = document.getElementById("wiz-load-error")!;
  const caseAEl = document.getElementById("wiz-case-a")!;
  const caseBEl = document.getElementById("wiz-case-b")!;
  const commandValueEl = document.getElementById("wiz-command-value")!;
  const commandCopyBtn = document.getElementById("wiz-command-copy")!;
  const recheckBtn = document.getElementById("wiz-recheck-btn")!;

  function readWizardIntent(): { siteDomain?: string } {
    try {
      return JSON.parse(sessionStorage.getItem("portaless_wizard_intent") ?? "{}");
    } catch {
      return {};
    }
  }

  async function checkAdminStatus(): Promise<void> {
    const res = await fetch("/admin/api/wizard/admin-status");
    if (!res.ok) {
      throw new Error(`No se pudo verificar el estado de la instalación (HTTP ${res.status}).`);
    }

    const data: AdminStatusResponse = await res.json();

    if (data.adminExists) {
      caseAEl.style.display = "";
      caseBEl.style.display = "none";
      return;
    }

    if (data.backend === "sqlite") {
      const { siteDomain } = readWizardIntent();
      const dbPath = siteDomain ? `./${siteDomain.replace(/[^a-z0-9.-]/gi, "_")}.db` : "./portaless.db";
      commandValueEl.textContent =
        `PORTALESS_ADMIN_USERNAME=admin PORTALESS_ADMIN_PASSWORD=cambia-esto PORTALESS_SQLITE_PATH=${dbPath} npm run setup`;
      caseAEl.style.display = "none";
      caseBEl.style.display = "";
    } else {
      caseAEl.style.display = "";
      caseBEl.style.display = "none";
    }
  }

  commandCopyBtn.addEventListener("click", async () => {
    try {
      await navigator.clipboard.writeText(commandValueEl.textContent ?? "");
      commandCopyBtn.textContent = "¡Copiado!";
      setTimeout(() => { commandCopyBtn.textContent = "Copiar"; }, 1500);
    } catch {}
  });

  recheckBtn.addEventListener("click", async () => {
    loadingEl.style.display = "";
    caseAEl.style.display = "none";
    caseBEl.style.display = "none";
    try {
      await checkAdminStatus();
    } catch (err) {
      errorEl.style.display = "";
      errorEl.textContent = (err as Error).message;
    } finally {
      loadingEl.style.display = "none";
    }
  });

  async function init(): Promise<void> {
    try {
      await checkAdminStatus();
      loadingEl.style.display = "none";
    } catch (err) {
      loadingEl.style.display = "none";
      errorEl.style.display = "";
      errorEl.textContent = (err as Error).message;
    }
  }

  init();
</script>

<style>
  .wiz-page-header { margin-bottom: 28px; max-width: 560px; }
  .wiz-step-indicator { margin: 0 0 6px; font-size: 0.78rem; color: var(--portaless-muted); text-transform: uppercase; letter-spacing: 0.04em; }
  .wiz-page-title { margin: 0 0 6px; font-size: 1.4rem; }
  .wiz-page-subtitle { margin: 0; color: var(--portaless-muted); font-size: 0.9rem; line-height: 1.5; }

  .wiz-loading, .wiz-load-error { font-size: 0.9rem; color: var(--portaless-muted); }
  .wiz-load-error { color: #ff6e6e; }

  .wiz-case-panel {
    max-width: 560px;
    padding: 20px;
    border: 1px solid var(--portaless-border);
    border-radius: 12px;
    background: #14161b;
  }
  .wiz-case-text { margin: 0 0 16px; font-size: 0.9rem; color: var(--portaless-fg); line-height: 1.5; }
  .wiz-case-hint { margin: 12px 0 16px; font-size: 0.8rem; color: var(--portaless-muted); }

  .wiz-login-btn {
    display: inline-block;
    border: 1px solid var(--portaless-accent);
    background: var(--portaless-accent);
    color: #0f1114;
    border-radius: 6px;
    padding: 10px 22px;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
  }

  .wiz-command-box { display: flex; gap: 8px; align-items: center; margin-bottom: 10px; }
  .wiz-command-value {
    flex: 1;
    padding: 10px 12px;
    background: #0f1114;
    border: 1px solid var(--portaless-border);
    border-radius: 6px;
    font-size: 0.78rem;
    word-break: break-all;
    color: var(--portaless-fg);
  }
  .wiz-command-copy {
    border: 1px solid var(--portaless-accent);
    background: var(--portaless-accent);
    color: #0f1114;
    border-radius: 6px;
    padding: 9px 14px;
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
  }

  .wiz-recheck-btn {
    border: 1px solid var(--portaless-border);
    background: transparent;
    color: var(--portaless-fg);
    border-radius: 6px;
    padding: 9px 18px;
    font-size: 0.85rem;
    cursor: pointer;
  }
</style>
