---
// /admin/wizard/rotate-identity (v0.0.9.30)
// Pantalla para rotar la identidad did:apw del sitio. Llama a
// POST /admin/api/site-identity con { rotate: true, confirm: "ROTAR",
// password, totpCode }. La clave privada nueva se muestra UNA sola vez y
// se ofrece para descargar, igual que en step-4-backup-key.
// Pagina autocontenida a proposito (sin layout compartido) para no
// depender de componentes que puedan cambiar; protegida por el mismo
// middleware de /admin/*.
import "../../../styles/global.css";
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Rotar identidad did:apw | Portaless</title>
    <style>
      body { max-width: 640px; margin: 2rem auto; padding: 0 1rem; }
      .warn { background: var(--warning-bg); border: 1px solid var(--warning-fg); border-radius: var(--radius-button); padding: 1rem; }
      label { display: block; margin-top: 1rem; font-weight: 600; }
      input { width: 100%; padding: .5rem; margin-top: .25rem; font-size: 1rem; box-sizing: border-box; border: 1px solid var(--panel-border); border-radius: var(--radius-input); background: var(--panel-bg); color: var(--text); font-family: var(--font-sans); }
      button { margin-top: 1.25rem; padding: .6rem 1.2rem; font-size: 1rem; border: 0; border-radius: var(--radius-button); cursor: pointer; font-family: var(--font-sans); font-weight: 600; }
      #rotate-btn { background: var(--danger-fg); color: var(--bg); }
      #rotate-btn:disabled { background: var(--panel-border); color: var(--muted); cursor: not-allowed; }
      #download-btn { background: var(--accent); color: #261C15; }
      #email-req-btn { background: var(--panel-bg); color: var(--text); border: 1px solid var(--panel-border); font-size: .9rem; }
      .stepup-box { margin-top: 1.25rem; padding: .9rem 1rem; border: 1px dashed var(--panel-border); border-radius: var(--radius-button); }
      .stepup-hint { margin: 0; font-size: .88rem; color: var(--muted); }
      .ok { color: var(--success-fg); margin-top: .75rem; }
      .error { color: var(--danger-fg); margin-top: 1rem; }
      code { word-break: break-all; font-family: var(--font-mono); }
      [hidden] { display: none; }
    </style>
  </head>
  <body>
    <p><a href="/admin/wizard">&larr; Volver al wizard</a></p>
    <h1>Rotar identidad did:apw</h1>
    <p>Identidad actual: <code id="current-did">cargando...</code></p>

    <div class="warn">
      <strong>Esto no se puede deshacer.</strong> La clave actual se descarta: todo lo firmado con ella deja de verificar.
      Rota solo si crees que la clave se filtro o si sabes que necesitas una nueva.
    </div>

    <form id="rotate-form">
      <label>Contrasena actual
        <input type="password" name="password" autocomplete="current-password" />
      </label>
      <label>Codigo 2FA (si lo tienes activo)
        <input type="text" name="totpCode" inputmode="numeric" autocomplete="one-time-code" maxlength="8" />
      </label>

      <div class="stepup-box">
        <p class="stepup-hint">Verificacion opcional por correo (step-up por email):</p>
        <button type="button" id="email-req-btn">Enviar codigo a mi correo</button>
        <p id="email-req-msg" hidden></p>
        <input type="hidden" name="emailToken" id="email-token" />
        <label>Codigo recibido por correo (opcional)
          <input type="text" name="emailCode" inputmode="numeric" autocomplete="one-time-code" maxlength="12" />
        </label>
      </div>

      <label>Escribe ROTAR para confirmar
        <input type="text" name="confirm" autocomplete="off" required />
      </label>
      <button type="submit" id="rotate-btn" disabled>Rotar identidad</button>
      <p class="error" id="error" hidden></p>
    </form>

    <section id="result" hidden>
      <h2>Identidad rotada</h2>
      <p>Anterior: <code id="previous-did"></code></p>
      <p>Nueva: <code id="new-did"></code></p>
      <div class="warn">
        Descarga ahora la clave privada nueva. <strong>No se vuelve a mostrar.</strong>
      </div>
      <button type="button" id="download-btn">Descargar clave privada</button>
    </section>

    <script>
      import { EMAIL_STEPUP_ERRORS, requestEmailStepUpCode } from "../../../lib/admin-email-stepup";

      const form = document.getElementById("rotate-form") as HTMLFormElement;
      const btn = document.getElementById("rotate-btn") as HTMLButtonElement;
      const errorEl = document.getElementById("error")!;
      const emailReqBtn = document.getElementById("email-req-btn") as HTMLButtonElement;
      const emailReqMsg = document.getElementById("email-req-msg")!;
      const emailTokenInput = document.getElementById("email-token") as HTMLInputElement;
      const confirmInput = form.elements.namedItem("confirm") as HTMLInputElement;
      let privateKeyJwk: unknown = null;

      fetch("/admin/api/site-identity")
        .then((r) => r.json())
        .then(({ identity }) => {
          document.getElementById("current-did")!.textContent = identity ? identity.did : "sin identidad (genera una en el wizard)";
          if (!identity) form.hidden = true;
        })
        .catch(() => (document.getElementById("current-did")!.textContent = "no se pudo cargar"));

      confirmInput.addEventListener("input", () => {
        btn.disabled = confirmInput.value.trim() !== "ROTAR";
      });

      emailReqBtn.addEventListener("click", async () => {
        emailReqBtn.disabled = true;
        emailReqMsg.hidden = true;
        const result = await requestEmailStepUpCode();
        if (result.ok && result.token) {
          emailTokenInput.value = result.token;
        }
        emailReqMsg.textContent = result.message;
        emailReqMsg.className = result.ok ? "ok" : "error";
        emailReqMsg.hidden = false;
        emailReqBtn.disabled = false;
      });

      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        errorEl.hidden = true;
        btn.disabled = true;
        const fd = new FormData(form);
        const body: Record<string, unknown> = {
          rotate: true,
          confirm: String(fd.get("confirm") || "").trim(),
        };
        const password = String(fd.get("password") || "");
        if (password) body.password = password;
        const totp = String(fd.get("totpCode") || "").trim();
        if (totp) body.totpCode = totp;
        const emailToken = String(fd.get("emailToken") || "").trim();
        const emailCode = String(fd.get("emailCode") || "").trim();
        if (emailToken || emailCode) {
          if (emailToken) body.emailToken = emailToken;
          if (emailCode) body.emailCode = emailCode;
        }

        try {
          const res = await fetch("/admin/api/site-identity", {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify(body),
          });
          const data = await res.json();
          if (!res.ok) {
            const mapped = typeof data.reason === "string" ? EMAIL_STEPUP_ERRORS[data.reason] : undefined;
            throw new Error(mapped || data.message || EMAIL_STEPUP_ERRORS[data.error] || data.error || "Error al rotar.");
          }
          privateKeyJwk = data.privateKeyJwk;
          form.reset();
          emailTokenInput.value = "";
          form.hidden = true;
          document.getElementById("previous-did")!.textContent = data.previousDid;
          document.getElementById("new-did")!.textContent = data.identity.did;
          document.getElementById("current-did")!.textContent = data.identity.did;
          document.getElementById("result")!.hidden = false;
        } catch (err) {
          errorEl.textContent = (err as Error).message;
          errorEl.hidden = false;
          btn.disabled = confirmInput.value.trim() !== "ROTAR";
        }
      });

      document.getElementById("download-btn")!.addEventListener("click", () => {
        if (!privateKeyJwk) return;
        const blob = new Blob([JSON.stringify(privateKeyJwk, null, 2)], { type: "application/json" });
        const a = document.createElement("a");
        a.href = URL.createObjectURL(blob);
        a.download = "portaless-did-apw-private-key.json";
        a.click();
        URL.revokeObjectURL(a.href);
      });

      window.addEventListener("beforeunload", (e) => {
        if (privateKeyJwk) e.preventDefault();
      });
    </script>
  </body>
</html>
