---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { postsLabel } from "../../lib/site-lang";

const posts = (await getCollection("posts"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<BaseLayout title={`${postsLabel()} — Portaless`}>
  <h1>{postsLabel()}</h1>
  {posts.length === 0 && <p class="empty-state">Todavía no hay publicaciones.</p>}
  {posts.map((post) => (
    <div class="card">
      <h3><a href={`./${post.id}/`}>{post.data.title}</a></h3>
      <p class="badge">{post.data.pubDate.toLocaleDateString("es-CL")}</p>
      {post.data.description && <p>{post.data.description}</p>}
    </div>
  ))}
</BaseLayout>
