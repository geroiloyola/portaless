---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { postsLabel } from "../../lib/site-lang";
import { ecosystemPageTheme } from "../../lib/ecosystem-theme";
import { publishedPosts } from "../../lib/llms-txt";

const posts = publishedPosts(await getCollection("posts"));

const pageTheme = ecosystemPageTheme();
---
<BaseLayout title={`${postsLabel()} — Portaless`} pageTheme={pageTheme}>
  <h1>{postsLabel()}</h1>
  {posts.length === 0 && <p class="empty-state">Todavía no hay publicaciones.</p>}
  {posts.map((post) => (
    <div class="card">
      <h3><a href={`./${post.id}/`}>{post.data.title}</a></h3>
      <p class="badge">{post.data.pubDate.toLocaleDateString("es-CL")}</p>
      {post.data.description && <p>{post.data.description}</p>}
    </div>
  ))}
</BaseLayout>
