---
// Detalle de cada post. Solo se generan los publicados (draft !== true):
// antes getStaticPaths generaba tambien los borradores, que no aparecian en
// los listados (index.astro y blog/index.astro ya filtraban) pero quedaban
// accesibles por URL directa. Mismo criterio que /llms.txt y /blog/<id>.md
// (publishedPosts() en src/lib/llms-txt.ts).
//
// PR D (llms.txt): cada post declara su version markdown con rel="alternate".
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ data }) => data.draft !== true);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const markdownUrl = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/blog/${post.id}.md`;
---
<BaseLayout title={`${post.data.title} — Portaless`} description={post.data.description} markdownUrl={markdownUrl}>
  <article>
    <h1>{post.data.title}</h1>
    <p class="badge">{post.data.pubDate.toLocaleDateString("es-CL")}</p>
    <Content />
  </article>
</BaseLayout>
