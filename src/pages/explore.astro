---
// Explore -- hub de descubrimiento del ecosistema Portaless.
//
// Proposito (docs/design/home-redesign.md): guiar tanto a una persona como a
// una IA a encontrar lo que busca, rapido, por CATEGORIA, en el contenido de
// este sitio. No finge un ranking de red: en hosting estatico no hay testigos,
// asi que el estado degradado honesto (fuente local, asOf, ventana, filtros)
// vive en un <details> al final, fuera del camino del usuario -- la promesa
// sigue escrita, pero no es lo primero que ve.
//
// Clasificacion automatica de las paginas demo por su arbol de elementos
// (ProfileHeader -> perfil, StoreBlock/ProductGrid -> tienda, resto -> pagina).
// El filtro de publicacion es el CANONICO (isDraft de deploy-engine).
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { isDraft } from "../../packages/deploy-engine/src/draft-filter";
import { ecosystemPageTheme } from "../lib/ecosystem-theme";
import type { ElementNode, PageLayout } from "../../packages/atomic-elements/src/types";

const base = import.meta.env.BASE_URL;
const pageTheme = ecosystemPageTheme();

const pageModules = import.meta.glob<{ default: PageLayout }>(
  "../content/pages/*.json",
  { eager: true }
);
const pages = Object.values(pageModules)
  .map((mod) => mod.default)
  .filter((page) => !isDraft(page))
  .sort((a, b) => a.slug.localeCompare(b.slug));

const posts = (await getCollection("posts"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

function flatten(nodes: ElementNode[]): ElementNode[] {
  return nodes.flatMap((n) => [
    n,
    ...(n.children ? flatten(n.children) : []),
    ...(n.columnSlots ? n.columnSlots.flatMap(flatten) : []),
  ]);
}
function kindOf(page: PageLayout): "profile" | "shop" | "page" {
  const flat = flatten(page.root);
  if (flat.some((n) => n.type === "ProfileHeader")) return "profile";
  if (flat.some((n) => n.type === "StoreBlock" || n.type === "ProductGrid" || n.type === "ProductCard")) return "shop";
  return "page";
}
const demoPages = pages.filter((p) => kindOf(p) === "page");
const demoShops = pages.filter((p) => kindOf(p) === "shop");
const demoProfiles = pages.filter((p) => kindOf(p) === "profile");

// Documentacion: los 4 documentos mas relevantes para empezar. Viven en el repo
// (todavia no son paginas; tenerlas como paginas hermosas es un commit futuro).
const REPO = "https://github.com/geroiloyola/portaless/blob/main";
const docs = [
  { title: "Install in 10 minutes", href: `${REPO}/docs/primos-pasos.md`, note: "Docker + navegador, guia para quien no escribe codigo." },
  { title: "Self-hosting", href: `${REPO}/docs/self-hosting.md`, note: "Node, Docker, Railway y Render, sin base expuesta." },
  { title: "Protocol APW", href: `${REPO}/docs/protocol-apw/APW-SPEC-v1.3.md`, note: "La especificacion normativa de identidad y evidencia." },
  { title: "Architecture", href: `${REPO}/docs/architecture/README.md`, note: "Como esta armado el kernel y sus modulos." },
];

const CATEGORIES = [
  { id: "documentation", label: "Documentation", count: docs.length },
  { id: "demo-pages", label: "Demo Pages", count: demoPages.length },
  { id: "demo-shops", label: "Demo Shops", count: demoShops.length },
  { id: "demo-profiles", label: "Demo Profiles", count: demoProfiles.length },
  { id: "publications", label: "Publications", count: posts.length },
].filter((c) => c.count > 0);

const trustHref = `${base}trust/default`;
const repoHref = "https://github.com/geroiloyola/portaless";

// Estado degradado honesto (Fase 9a): Explore es estatica; el orden normativo
// por testigos se calcula en un nodo con functions/. Vive en el <details>.
const buildAsOf = new Date().toISOString();
const windowSeconds = 30 * 86400;
const RANKING_FILTERS = ["top", "confidence", "recents", "new", "old", "history"] as const;
---

<BaseLayout
  title="Explore — Portaless"
  description="Descubrí por categoría los sitios, perfiles, publicaciones y documentación hechos con Portaless."
  pageTheme={pageTheme}
>
  <h1>Explore</h1>
  <p class="explore-intro">
    Todo lo que este sitio publica, agrupado por categoría para que lo encuentres rápido —
    vos o un agente de IA. La clasificación es automática (por el contenido de cada página).
  </p>

  <div class="explore-order">
    <span class="explore-order-label">Order by</span>
    <div class="explore-order-pills" role="radiogroup" aria-label="Order by">
      {RANKING_FILTERS.map((f) => (
        <label class="explore-order-pill">
          <input type="radio" name="explore-order" value={f} checked={f === "new"} />
          <span>{f}</span>
        </label>
      ))}
    </div>
  </div>
  <p class="explore-order-status" id="explore-order-status" role="status"></p>

  <nav class="explore-chips" aria-label="Categorías">
    <a href="#documentation" class="explore-chip">Documentation</a>
    {demoPages.length > 0 && <a href="#demo-pages" class="explore-chip">Demo Pages</a>}
    {demoShops.length > 0 && <a href="#demo-shops" class="explore-chip">Demo Shops</a>}
    {demoProfiles.length > 0 && <a href="#demo-profiles" class="explore-chip">Demo Profiles</a>}
    {posts.length > 0 && <a href="#publications" class="explore-chip">Publications</a>}
  </nav>

  <section id="documentation">
    <h2>Documentation</h2>
    <div class="explore-grid">
      {docs.map((doc) => (
        <a class="explore-card" href={doc.href} target="_blank" rel="noopener noreferrer">
          <h3>{doc.title}</h3>
          <p>{doc.note}</p>
        </a>
      ))}
    </div>
  </section>

  {demoPages.length > 0 && (
    <section id="demo-pages">
      <h2>Demo Pages</h2>
      <div class="explore-grid">
        {demoPages.map((page) => (
          <a class="explore-card" href={`${base}paginas/${page.slug}/`}>
            <h3>{page.title || page.slug}</h3>
            {page.description && <p>{page.description}</p>}
          </a>
        ))}
      </div>
    </section>
  )}

  {demoShops.length > 0 && (
    <section id="demo-shops">
      <h2>Demo Shops</h2>
      <div class="explore-grid">
        {demoShops.map((page) => (
          <a class="explore-card" href={`${base}paginas/${page.slug}/`}>
            <h3>{page.title || page.slug}</h3>
            {page.description && <p>{page.description}</p>}
          </a>
        ))}
      </div>
    </section>
  )}

  {demoProfiles.length > 0 && (
    <section id="demo-profiles">
      <h2>Demo Profiles</h2>
      <div class="explore-grid">
        {demoProfiles.map((page) => (
          <a class="explore-card" href={`${base}paginas/${page.slug}/`}>
            <h3>{page.title || page.slug}</h3>
            {page.description && <p>{page.description}</p>}
          </a>
        ))}
      </div>
    </section>
  )}

  {posts.length > 0 && (
    <section id="publications">
      <h2>Publications</h2>
      <div class="explore-grid">
        {posts.map((post) => (
          <a class="explore-card" href={`${base}blog/${post.id}/`} data-order={post.data.pubDate.toISOString()}>
            <h3>{post.data.title}</h3>
            <p class="explore-card-meta">{post.data.pubDate.toLocaleDateString("es-CL")}</p>
            {post.data.description && <p>{post.data.description}</p>}
          </a>
        ))}
      </div>
    </section>
  )}

  <section id="how">
    <h2>Cómo se publica</h2>
    <div class="explore-grid">
      <a class="explore-card" href={`${base}proyecciones/`}>
        <h3>Un canon, cinco proyecciones</h3>
        <p>Cada publicación nace una sola vez y se deriva a página, feed, manifiesto, índice y una plataforma externa.</p>
      </a>
    </div>
  </section>

  <section id="network">
    <h2>Red Portaless</h2>
    <div class="explore-grid">
      <a class="explore-card" href={trustHref}>
        <h3>TrustScore de este sitio</h3>
        <p>La señal de confianza del sitio, verificada por la red Portaless.</p>
      </a>
      <a class="explore-card" href={repoHref} target="_blank" rel="noopener noreferrer">
        <h3>Repositorio de Portaless</h3>
        <p>Todo el ecosistema es open source bajo licencia AGPL-3.0.</p>
      </a>
    </div>
  </section>

  <details class="explore-about" data-explore-source="local">
    <summary>How this list is ordered</summary>
    <p>
      <strong>Fuente:</strong> contenido local de este sitio (build).
      <strong>asOf:</strong> <time datetime={buildAsOf}>{buildAsOf}</time>.
      <strong>Ventana:</strong> {windowSeconds / 86400} días (solo aplica a <code>top</code>).
      El orden por atestaciones firmadas y observaciones de testigos
      (<code>top</code>, <code>confidence</code>) se calcula en un nodo con
      <code>functions/</code>, no en este hosting estático: por eso acá no se finge un ranking.
      Filtros normativos: {RANKING_FILTERS.join(", ")}.
    </p>
  </details>
</BaseLayout>

<script>
  // Order by. Ordena de verdad donde hay dato local (la fecha de publicación de
  // los posts) y dice, sin fingir, que los criterios de red necesitan un nodo.
  // Orden estable: las tarjetas sin fecha (docs, páginas demo) conservan su
  // orden relativo; solo se reordenan las que tienen data-order.
  const NOTES: Record<string, string> = {
    new: "Newest first, by publish date (local).",
    old: "Oldest first, by publish date (local).",
    recents: "Newest first by publish date — a local approximation. The network order (last position observed by a witness) needs a node with functions/.",
    top: "The weighted Bayesian score over the declared window needs signed attestations from a node with functions/; showing the local order instead.",
    confidence: "Witness consensus over the declared seq needs a node with functions/; showing the local order instead.",
    history: "Order by amount of evidence per subject needs attestations from a node with functions/; showing the local order instead.",
  };

  const status = document.getElementById("explore-order-status");

  function reorder(criterion: string): void {
    const desc = criterion === "new" || criterion === "recents";
    const asc = criterion === "old";
    const apply = desc || asc;

    document.querySelectorAll(".explore-grid").forEach((grid) => {
      const cards = Array.from(grid.children) as HTMLElement[];
      cards.forEach((card, i) => card.setAttribute("data-idx", String(i)));
      cards.sort((a, b) => {
        const da = a.getAttribute("data-order");
        const db = b.getAttribute("data-order");
        if (apply && da && db) return desc ? db.localeCompare(da) : da.localeCompare(db);
        return Number(a.getAttribute("data-idx")) - Number(b.getAttribute("data-idx"));
      });
      cards.forEach((card) => grid.appendChild(card));
    });

    if (status) status.textContent = NOTES[criterion] ?? "";
  }

  document.querySelectorAll('input[name="explore-order"]').forEach((el) => {
    el.addEventListener("change", () => reorder((el as HTMLInputElement).value));
  });
  reorder("new");
</script>

<style>
  .explore-intro { color: var(--muted, #6e6653); max-width: 70ch; }
  .explore-chips { display: flex; flex-wrap: wrap; gap: 8px; margin: 16px 0 8px; }
  .explore-chip {
    padding: 6px 14px;
    border: 1px solid var(--panel-border, #e4e6c3);
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
  }
  .explore-chip:hover { border-color: var(--accent); }
  section { margin-top: 40px; }
  .explore-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px; margin-top: 16px; }
  .explore-card {
    display: block;
    border: 1px solid var(--panel-border, #e4e6c3);
    border-radius: var(--radius-card, 16px);
    padding: 18px 20px;
    background: var(--panel-bg, #fff);
    text-decoration: none;
    color: inherit;
  }
  .explore-card:hover { border-color: var(--accent); }
  .explore-card h3 { margin: 0 0 6px; font-size: 1rem; }
  .explore-card p { margin: 0; color: var(--muted, #6e6653); font-size: 0.88rem; line-height: 1.5; }
  .explore-card-meta { font-size: 0.78rem !important; margin-bottom: 6px !important; }
  .explore-about { margin-top: 48px; color: var(--muted, #6e6653); font-size: 0.85rem; }
  .explore-about summary { cursor: pointer; font-weight: 600; }
  .explore-about p { max-width: 80ch; line-height: 1.6; }

  .explore-order { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; margin: 18px 0 4px; }
  .explore-order-label { font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted, #6e6653); font-weight: 700; }
  .explore-order-pills {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 4px;
    padding: 4px;
    border: 1px solid var(--panel-border, #e4e6c3);
    border-radius: 999px;
    background: var(--panel-bg, #fff);
  }
  .explore-order-pill { position: relative; cursor: pointer; }
  .explore-order-pill input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .explore-order-pill span {
    display: inline-block;
    padding: 5px 14px;
    border-radius: 999px;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--muted, #6e6653);
    text-transform: capitalize;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .explore-order-pill span:hover { color: var(--text, #261c15); }
  .explore-order-pill input:checked + span { background: var(--accent, #c5d86d); color: #261c15; }
  .explore-order-pill input:focus-visible + span { outline: 2px solid var(--accent-text, #5a6b24); outline-offset: 2px; }
  .explore-order-status { font-size: 0.82rem; color: var(--muted, #6e6653); margin: 6px 0 0; max-width: 80ch; }
</style>
