---
// Ruta dinamica de la version PRIMARIA de cada pagina de contenido
// (/pages/<slug>/). Las traducciones viven en /[locale]/pages/<slug>/.
// La logica de idioma/versiones esta en src/lib/content-pages.ts.
import ContentPage from "../../components/ContentPage.astro";
import { loadContentPages, type ContentPage as ContentPageData, type PageVersion } from "../../lib/content-pages";

export async function getStaticPaths() {
  return loadContentPages().map((page) => ({
    params: { slug: page.slug },
    props: { page, version: page.primary },
  }));
}

const { page, version } = Astro.props as { page: ContentPageData; version: PageVersion };
---

<ContentPage page={page} version={version} />
