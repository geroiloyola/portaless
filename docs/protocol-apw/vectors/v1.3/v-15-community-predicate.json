      ],
      "judges": { "did:apw:a.example": 7.0 },
      "expectEmitters": 1,
      "expectWeightSum": 1.0,
      "tolerance": 1e-9,
      "expectPasses": false,
      "expectRows": [{ "iss": "did:apw:a.example", "val": 5, "iat": 1800000000 }]
