{
  "format": "ltp-reputation-static-vector",
  "version": "0.1",
  "family": "REP-04",
  "title": "REP-04 — Community eligibility, age and min_weight",
  "status": "static-oracle-target",
  "engineImplemented": false,
  "arithmetic": "binary64 + absolute 1e-9 tolerance; rationals are oracle metadata",
  "source": "LTP-S3-REPUTATION-MISSING-VECTORS.md",
  "cases": [
    {
      "id": "REP-04-01",
      "kind": "communityEligibility",
      "description": "Emitter history exactly 7 days.",
      "input": {
        "emitters": [
          {
            "did": "did:apw:a.example",
            "ageSeconds": 604800,
            "weight": 1.0,
            "self": false
          }
        ],
        "minWeight": 2.0
      },
      "expected": {
        "eligible": true,
        "eligibleEmitters": 1,
        "distinctEmitters": 1,
        "acceptedEmitters": 1,
        "overFanoutCap": false,
        "weightSum": 1.0,
        "countsTowardMinWeight": true,
        "minWeight": 2.0,
        "minWeightPass": false,
        "absent": true,
        "rejectedByCap": 0
      }
    },
    {
