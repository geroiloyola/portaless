# Portaless -- variables de entorno de referencia (v0.0.9.30)
# Copia este archivo a .env y completa solo lo que necesites -- Portaless
# funciona sin configurar nada, sirviendo solo el sitio estatico base.
# NUNCA commitees un archivo .env real con secretos -- .env ya esta en
# .gitignore, este .env.example es solo documentacion.

# --- Comercio (opcional) -----------------------------------------------
# true para activar /tienda (requiere src/commerce/config.ts, ver
# docs/COMMERCE_SETUP.md -- copia src/commerce/config.example.ts primero)
ENABLE_COMMERCE=false

# --- Trust Layer (opcional) ---------------------------------------------
# true para activar la verificacion de agentes de IA en functions/_middleware.js
ENABLE_TRUST_LAYER=false
# Reserva de admision de directorios Web Bot Auth (no concede acceso al sitio).
# Solo estos origenes pueden usar los 2 huecos reservados; una firma valida
# previa NUNCA promueve un origen. 6 huecos normales, maximo total 8 por proceso/isolate.
# HTTPS, separados por comas, sin usuario/password, path, query, fragmento ni wildcard.
# Ejemplo: https://lector.example,https://otro-lector.example:8443
# Se normalizan case/IDN/puerto por defecto/punto final y se deduplican.
# Entradas invalidas/privadas locales y las posteriores a las primeras 256
# entradas no vacias se descartan; vacio/todo invalido = ninguna reserva asignada.
PORTALESS_WBA_RESERVED_ORIGINS=
# Presupuesto pre-autenticación PR2: integración inicial solo del adaptador
# de directorio; perfil experimental, desactivado por defecto. No activa todavía
# presupuesto TXT/DoH, DID, historial ni evidencia.
PORTALESS_RESOLUTION_BUDGET_ENABLED=false
# Obligatorio (>=32 caracteres aleatorios) al habilitar el presupuesto.
# Durante rotación, configura SECRET como clave nueva y conserva PREVIOUS
# durante el solapamiento; ambas identidades HMAC consumen la misma cuota.
PORTALESS_RESOLUTION_BUDGET_SECRET=
PORTALESS_RESOLUTION_BUDGET_PREVIOUS_SECRET=
# En Cloudflare, habilitar únicamente con ingress confiable y origen protegido.
PORTALESS_TRUSTED_CLOUDFLARE_INGRESS=false

# --- SiteTrustScore: voto community (IP_HASH_SALT) -----------------------
# Salt para hashear la IP del votante antes de guardarla. OBLIGATORIO para
# que funcione POST /trust/:siteId/vote: sin esta variable el endpoint
# responde 500 server_misconfigured y el voto queda deshabilitado. No hay
# salt de desarrollo a proposito -- uno publico vuelve reversible por fuerza
# bruta el hash de una IPv4 (2^32 intentos). Genera uno con:
#   openssl rand -base64 32
IP_HASH_SALT=

# --- Autenticacion: admin inicial ---------------------------------------
# Usados por `npm run setup` (ver scripts/SETUP.md) -- si se omiten,
# el script usa "admin" como usuario y genera una contraseña aleatoria
# que se imprime una sola vez en la terminal.
PORTALESS_ADMIN_USERNAME=admin
PORTALESS_ADMIN_PASSWORD=

# --- Autenticacion: persistencia self-hosted -----------------------------
# Ruta al archivo SQLite. Usa better-sqlite3 (desde el PR #42) y requiere
# Node >= 24 (minimo real del proyecto por isolated-vm@7, ver engines en
# package.json). Si se omite, usa ./portaless.db en la raiz del proyecto.
PORTALESS_SQLITE_PATH=./portaless.db

# --- Autenticacion: recuperacion de contraseña (v0.0.9.4) ----------------
# "1" para que el endpoint de recuperacion devuelva el token directamente
# en la respuesta HTTP -- solo para desarrollo local sin servidor de
# correo configurado. NUNCA activar esto en produccion (revela el token
# de reset a cualquiera que llame al endpoint).
PORTALESS_DEV_MODE=

# --- Autenticacion: OAuth/SSO (v0.0.9.4, opcional) -----------------------
# Repetir este bloque de 5 variables por cada proveedor que quieras
# habilitar, reemplazando GOOGLE por el nombre del proveedor en mayusculas
# (ej. GITHUB). Sin las 5 variables completas para un proveedor, el
# inicio de sesion con ese proveedor simplemente no esta disponible -- no
# falla de forma insegura.
#
# Ejemplo con Google:
# PORTALESS_OAUTH_GOOGLE_CLIENT_ID=
# PORTALESS_OAUTH_GOOGLE_CLIENT_SECRET=
# PORTALESS_OAUTH_GOOGLE_AUTH_URL=https://accounts.google.com/o/oauth2/v2/auth
# PORTALESS_OAUTH_GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
# PORTALESS_OAUTH_GOOGLE_USERINFO_URL=https://openidconnect.googleapis.com/v1/userinfo
#
# Ejemplo con GitHub:
# PORTALESS_OAUTH_GITHUB_CLIENT_ID=
# PORTALESS_OAUTH_GITHUB_CLIENT_SECRET=
# PORTALESS_OAUTH_GITHUB_AUTH_URL=https://github.com/login/oauth/authorize
# PORTALESS_OAUTH_GITHUB_TOKEN_URL=https://github.com/login/oauth/access_token
# PORTALESS_OAUTH_GITHUB_USERINFO_URL=https://api.github.com/user

# --- Plugin sandbox: Capability Bridge (v0.0.9.30, opcional) --------------
# URL publica del endpoint functions/api/internal/capability-bridge.js de
# ESTE sitio, ej. https://tudominio.com/api/internal/capability-bridge
# La usan los adaptadores edge (deno-deploy.ts y
# cloudflare-workers-for-platforms.ts) como fallback cuando
# SandboxExecutionInput.bridgeUrl no viene definido: el plugin, que corre
# en la infraestructura del proveedor, llama a esta URL para ejercer
# capacidades no-red (content:read, storage:write, etc.).
# Solo hace falta si usas Deno Deploy o Cloudflare Workers for Platforms;
# el adaptador self-hosted (isolated-vm) no la usa.
# No es un secreto: la autenticacion del bridge usa tokens efimeros por
# ejecucion (CapabilityTokenStore, PR #40), emitidos via
# issueCapabilityToken. La variable PORTALESS_INTERNAL_BRIDGE_TOKEN de
# versiones anteriores quedo OBSOLETA y ya no se lee.
# PORTALESS_CAPABILITY_BRIDGE_URL=

# --- Cloudflare D1 (produccion, no es una variable de entorno tradicional) ---
# El binding `DB` se configura en wrangler.toml, no aqui -- ver
# docs/DEPLOY_CLOUDFLARE_PAGES.md.

# --- Publicacion integrada (C34) -----------------------------------------
# Proveedor registrado en publication_runs. Hoy el deployer cableado es
# github-pages; otros proveedores requieren un runner inyectable/adaptador.
# PORTALESS_PUBLISH_PROVIDER=github-pages

# --- OpenAI-compatible provider (C32) ------------------------------------
# La API key se lee solo server-side y nunca se devuelve al navegador ni a MCP.
# PORTALESS_OPENAI_API_KEY=
# PORTALESS_OPENAI_BASE_URL=https://api.openai.com/v1
# PORTALESS_OPENAI_MODEL=
# PORTALESS_OPENAI_TIMEOUT_MS=30000

# --- Cloudflare Pages connection check (C35) ------------------------------
# Solo para validar el proyecto desde /admin/api/wizard/connection-status.
# PORTALESS_CLOUDFLARE_API_TOKEN=
# PORTALESS_CLOUDFLARE_ACCOUNT_ID=
# PORTALESS_CLOUDFLARE_PAGES_PROJECT=

# --- Nodo privado / concurrencia (C37) ------------------------------------
# PORTALESS_MAX_CONCURRENT_REQUESTS=64
# PORTALESS_DATA_DIR=/data
