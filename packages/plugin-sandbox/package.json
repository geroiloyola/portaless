{
  "name": "@portaless/plugin-sandbox",
  "version": "0.0.6",
  "description": "Sandboxing real de plugins de Portaless, adaptadores intercambiables (Cloudflare, Deno Deploy, Fastly, isolated-vm self-hosted).",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "main": "src/index.ts",
  "dependencies": {
    "isolated-vm": "^7.0.1"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./types": {
      "types": "./src/types.ts",
      "import": "./src/types.ts"
    },
    "./node-isolated-vm": {
      "types": "./src/adapters/node-isolated-vm.ts",
      "import": "./src/adapters/node-isolated-vm.ts"
    },
    "./capability-backends": {
      "types": "./src/capabilities/capability-backends.ts",
      "import": "./src/capabilities/capability-backends.ts"
    },
    "./capability-registry": {
      "types": "./src/capabilities/capability-registry.ts",
      "import": "./src/capabilities/capability-registry.ts"
    },
    "./install-reconcile": {
      "types": "./src/install/reconcile.ts",
      "import": "./src/install/reconcile.ts"
    },
    "./manifest-schema": {
      "types": "./src/manifest/manifest-schema.ts",
      "import": "./src/manifest/manifest-schema.ts"
    },
    "./plugin-artifacts": {
      "types": "./src/registry/plugin-artifacts.ts",
      "import": "./src/registry/plugin-artifacts.ts"
    },
    "./plugin-registry": {
      "types": "./src/registry/plugin-registry.ts",
      "import": "./src/registry/plugin-registry.ts"
    },
    "./store-factory": {
      "types": "./src/registry/store-factory.ts",
      "import": "./src/registry/store-factory.ts"
    },
    "./capability-token-store-factory": {
      "types": "./src/registry/stores/capability-token-store-factory.ts",
      "import": "./src/registry/stores/capability-token-store-factory.ts"
    },
    "./production-plugin-runner": {
      "types": "./src/runtime/production-plugin-runner.ts",
      "import": "./src/runtime/production-plugin-runner.ts"
    }
  }
}
