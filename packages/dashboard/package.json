{
  "name": "@portaless/dashboard",
  "version": "0.0.3",
  "description": "Panel de administracion modular de Portaless: presets de skin (skin-engine) con herencia y tokens de diseno, ajustes del sitio y feed de actividad.",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "main": "src/index.ts",
  "dependencies": {},
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./activity": {
      "types": "./src/activity/activity-store.ts",
      "import": "./src/activity/activity-store.ts"
    },
    "./docs-nav": "./src/docs-nav.mjs",
    "./site-settings": {
      "types": "./src/site-settings/site-settings-store.ts",
      "import": "./src/site-settings/site-settings-store.ts"
    },
    "./analytics-config": {
      "types": "./src/site-settings/analytics-config.ts",
      "import": "./src/site-settings/analytics-config.ts"
    },
    "./skin-store": {
      "types": "./src/skin-engine/site-skin-store.ts",
      "import": "./src/skin-engine/site-skin-store.ts"
    },
    "./skin-tokens": {
      "types": "./src/skin-engine/tokens.ts",
      "import": "./src/skin-engine/tokens.ts"
    }
  }
}
