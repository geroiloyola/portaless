{
  "name": "@portaless/apw-resolver",
  "version": "0.1.0",
  "description": "Standalone client/resolver for Protocol APW: resolve did:apw identities, verify site manifests (DNS TXT), chained history, and JWS signatures. Zero Portaless dependencies — only Web APIs + canonicalize (JCS).",
  "license": "AGPL-3.0-or-later",
  "keywords": [
    "apw",
    "did",
    "dnslink",
    "jws",
    "jcs",
    "ed25519",
    "protocol"
  ],
  "type": "module",
  "main": "./dist/standalone.js",
  "types": "./dist/standalone.d.ts",
  "exports": {
    ".": {
      "types": "./dist/standalone.d.ts",
      "import": "./dist/standalone.js"
    },
    "./full": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./resolver": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./did-apw": {
      "types": "./src/did-apw/index.ts",
      "import": "./src/did-apw/index.ts"
    },
    "./scoring": {
      "types": "./src/scoring/index.ts",
      "import": "./src/scoring/index.ts"
    },
    "./federation": {
      "types": "./src/federation/index.ts",
      "import": "./src/federation/index.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && esbuild src/standalone.ts src/index.ts --bundle --format=esm --platform=neutral --external:canonicalize --outdir=dist && esbuild conformance/cli.ts --bundle --format=esm --platform=node --external:canonicalize --outfile=dist/conformance/cli.js",
    "prepublishOnly": "npm run build",
    "conformance": "tsx conformance/cli.ts"
  },
  "dependencies": {
    "canonicalize": "^2.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "apw-conformance": "dist/conformance/cli.js"
  }
}
