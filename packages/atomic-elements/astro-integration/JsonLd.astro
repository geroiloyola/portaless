---
import { buildJsonLd, type SiteInfo } from "../src/seo/json-ld";
import type { PageLayout } from "../src/types";

export interface Props {
  layout: PageLayout;
  site: SiteInfo;
}

const { layout, site } = Astro.props;
// v0.0.9.24: buildJsonLd() ahora es async -- necesita resolver los
// productos reales de Medusa para cada ProductGrid antes de poder armar
// el itemListElement del ItemList (antes se devolvia sin productos, un
// ItemList vacio que no correspondia al catalogo real). El frontmatter
// de Astro soporta await de forma nativa, asi que el unico cambio real
// es agregar la palabra "await" -- ver docs/architecture/site-trust-score.md
// y el commit que corrige esto en packages/atomic-elements/src/seo/json-ld.ts.
const jsonLd = await buildJsonLd(layout, site);
---
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
